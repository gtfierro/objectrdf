@prefix : <urn:example/watertap/seawater-ro/pretreatment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix seawater-ro: <https://w3id.org/objectrdf/seawater-ro#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:example/watertap/seawater-ro/pretreatment> a owl:Ontology ;
    owl:imports <http://qudt.org/3.4.0/qudt-all>,
        seawater-ro:,
        <https://watermetadata.org/ontology/watr> .

:pretreatment-system a s223:System ;
    rdfs:label "pretreatment-system" ;
    s223:hasBoundaryConnectionPoint :backwash-out,
        :cartridge-product-out,
        :intake-seawater-in ;
    s223:hasMember :antiscalant-addition,
        :backwash-handling,
        :cartridge-filtration,
        :chlorination,
        :ferric-chloride-addition,
        :intake,
        :media-filtration,
        :static-mixer,
        :storage-tank-1 .

<https://watermetadata.org/ontology/watr> owl:versionInfo "0.3.rc1" .

:storage-tank-1-residence-time a s223:QuantifiableProperty ;
    rdfs:label "Nominal residence time" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 2e+00 ;
    qudt:hasQuantityKind quantitykind:Time ;
    qudt:hasUnit unit:HR .

:antiscalant-addition--cartridge-filtration a s223:Pipe ;
    rdfs:label "antiscalant-addition--cartridge-filtration" ;
    s223:connectsAt :antiscalant-addition-out,
        :cartridge-filtration-in ;
    s223:hasMedium watr:Water-Seawater .

:antiscalant-addition-in a s223:InletConnectionPoint ;
    rdfs:label "antiscalant-addition-in" ;
    s223:connectsThrough :media-product-out--antiscalant-addition ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :antiscalant-addition .

:antiscalant-addition-out a s223:OutletConnectionPoint ;
    rdfs:label "antiscalant-addition-out" ;
    s223:connectsThrough :antiscalant-addition--cartridge-filtration ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :antiscalant-addition .

:backwash-handling-in a s223:InletConnectionPoint ;
    rdfs:label "backwash-handling-in" ;
    s223:connectsThrough :s06 ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :backwash-handling .

:backwash-out a s223:OutletConnectionPoint ;
    rdfs:label "backwash-out" ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :backwash-handling .

:cartridge-filtration-in a s223:InletConnectionPoint ;
    rdfs:label "cartridge-filtration-in" ;
    s223:connectsThrough :antiscalant-addition--cartridge-filtration ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :cartridge-filtration .

:cartridge-product-out a s223:OutletConnectionPoint ;
    rdfs:label "cartridge-product-out" ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :cartridge-filtration .

:chlorination--static-mixer a s223:Pipe ;
    rdfs:label "chlorination--static-mixer" ;
    s223:connectsAt :chlorination-out,
        :static-mixer-in ;
    s223:hasMedium watr:Water-Seawater .

:chlorination-in a s223:InletConnectionPoint ;
    rdfs:label "chlorination-in" ;
    s223:connectsThrough :ferric-chloride-addition--chlorination ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :chlorination .

:chlorination-out a s223:OutletConnectionPoint ;
    rdfs:label "chlorination-out" ;
    s223:connectsThrough :chlorination--static-mixer ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :chlorination .

:ferric-chloride-addition--chlorination a s223:Pipe ;
    rdfs:label "ferric-chloride-addition--chlorination" ;
    s223:connectsAt :chlorination-in,
        :ferric-chloride-addition-out ;
    s223:hasMedium watr:Water-Seawater .

:ferric-chloride-addition-in a s223:InletConnectionPoint ;
    rdfs:label "ferric-chloride-addition-in" ;
    s223:connectsThrough :intake--ferric-chloride-addition ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :ferric-chloride-addition .

:ferric-chloride-addition-out a s223:OutletConnectionPoint ;
    rdfs:label "ferric-chloride-addition-out" ;
    s223:connectsThrough :ferric-chloride-addition--chlorination ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :ferric-chloride-addition .

:intake--ferric-chloride-addition a s223:Pipe ;
    rdfs:label "intake--ferric-chloride-addition" ;
    s223:connectsAt :ferric-chloride-addition-in,
        :intake-out ;
    s223:hasMedium watr:Water-Seawater .

:intake-out a s223:OutletConnectionPoint ;
    rdfs:label "intake-out" ;
    s223:connectsThrough :intake--ferric-chloride-addition ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :intake .

:intake-seawater-in a s223:InletConnectionPoint ;
    rdfs:label "intake-seawater-in" ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :intake .

:media-backwash-out a s223:OutletConnectionPoint ;
    rdfs:label "media-backwash-out" ;
    s223:connectsThrough :s06 ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :media-filtration .

:media-filtration-in a s223:InletConnectionPoint ;
    rdfs:label "media-filtration-in" ;
    s223:connectsThrough :storage-tank-1--media-filtration ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :media-filtration .

:media-product-out a s223:OutletConnectionPoint ;
    rdfs:label "media-product-out" ;
    s223:connectsThrough :media-product-out--antiscalant-addition ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :media-filtration .

:media-product-out--antiscalant-addition a s223:Pipe ;
    rdfs:label "media-product-out--antiscalant-addition" ;
    s223:connectsAt :antiscalant-addition-in,
        :media-product-out ;
    s223:hasMedium watr:Water-Seawater .

:s06 a s223:Pipe ;
    rdfs:label "s06" ;
    s223:connectsAt :backwash-handling-in,
        :media-backwash-out ;
    s223:hasMedium watr:Water-Seawater ;
    s223:hasRole watr:Role-Backwash .

:static-mixer--storage-tank-1 a s223:Pipe ;
    rdfs:label "static-mixer--storage-tank-1" ;
    s223:connectsAt :static-mixer-out,
        :storage-tank-1-in ;
    s223:hasMedium watr:Water-Seawater .

:static-mixer-in a s223:InletConnectionPoint ;
    rdfs:label "static-mixer-in" ;
    s223:connectsThrough :chlorination--static-mixer ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :static-mixer .

:static-mixer-out a s223:OutletConnectionPoint ;
    rdfs:label "static-mixer-out" ;
    s223:connectsThrough :static-mixer--storage-tank-1 ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :static-mixer .

:storage-tank-1--media-filtration a s223:Pipe ;
    rdfs:label "storage-tank-1--media-filtration" ;
    s223:connectsAt :media-filtration-in,
        :storage-tank-1-out ;
    s223:hasMedium watr:Water-Seawater .

:storage-tank-1-in a s223:InletConnectionPoint ;
    rdfs:label "storage-tank-1-in" ;
    s223:connectsThrough :static-mixer--storage-tank-1 ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :storage-tank-1 .

:storage-tank-1-out a s223:OutletConnectionPoint ;
    rdfs:label "storage-tank-1-out" ;
    s223:connectsThrough :storage-tank-1--media-filtration ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :storage-tank-1 .

:antiscalant-addition a seawater-ro:DosingStage ;
    rdfs:label "Antiscalant addition" ;
    s223:hasConnectionPoint :antiscalant-addition-in,
        :antiscalant-addition-out ;
    watr:hasProcess watr:Process-Dosing .

:backwash-handling a seawater-ro:BackwashStage ;
    rdfs:label "Media-filter backwash handling" ;
    s223:hasConnectionPoint :backwash-handling-in,
        :backwash-out ;
    watr:hasProcess watr:Process-Backwashing .

:cartridge-filtration a seawater-ro:CartridgeFiltrationStage ;
    rdfs:label "Cartridge filtration" ;
    s223:hasConnectionPoint :cartridge-filtration-in,
        :cartridge-product-out ;
    rdfs:comment "WaterTAP cartridge filtration zero-order unit model." ;
    watr:hasProcess watr:Process-Filtration .

:chlorination a seawater-ro:ChlorinationStage ;
    rdfs:label "chlorination" ;
    s223:hasConnectionPoint :chlorination-in,
        :chlorination-out ;
    watr:hasProcess watr:Process-Chlorination .

:ferric-chloride-addition a seawater-ro:CoagulationStage ;
    rdfs:label "Ferric chloride addition" ;
    s223:hasConnectionPoint :ferric-chloride-addition-in,
        :ferric-chloride-addition-out ;
    watr:hasProcess watr:Process-Coagulation .

:intake a seawater-ro:IntakePump ;
    rdfs:label "Seawater intake" ;
    s223:hasConnectionPoint :intake-out,
        :intake-seawater-in ;
    s223:hasRole watr:Role-Feed .

:static-mixer a seawater-ro:MixingStage ;
    rdfs:label "Static mixer" ;
    s223:hasConnectionPoint :static-mixer-in,
        :static-mixer-out ;
    watr:hasProcess watr:Process-Mixing .

:storage-tank-1 a seawater-ro:StorageTank ;
    rdfs:label "Pretreatment storage tank" ;
    s223:hasConnectionPoint :storage-tank-1-in,
        :storage-tank-1-out ;
    s223:hasProperty :storage-tank-1-residence-time ;
    s223:hasRole watr:Role-Storage .

:media-filtration a seawater-ro:MediaFiltrationStage ;
    rdfs:label "Media filtration" ;
    s223:hasConnectionPoint :media-backwash-out,
        :media-filtration-in,
        :media-product-out ;
    rdfs:comment "WaterTAP media filtration zero-order unit model." ;
    watr:hasProcess watr:Process-MediaFiltration .

