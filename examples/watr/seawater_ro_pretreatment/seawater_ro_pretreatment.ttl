@prefix : <urn:example/watertap/seawater-ro/pretreatment#> .
@prefix ns1: <https://watermetadata.org/ontology/watr#> .
@prefix ns2: <http://qudt.org/schema/qudt/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix seawaterro: <https://w3id.org/objectrdf/seawater-ro#> .
@prefix watr: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:example/watertap/seawater-ro/pretreatment> a owl:Ontology ;
    owl:imports <http://qudt.org/3.4.0/qudt-all>,
        seawaterro:,
        <https://watermetadata.org/ontology/watr> .

:pretreatment-system a watr:System ;
    rdfs:label "pretreatment-system" ;
    watr:hasBoundaryConnectionPoint :backwash-out,
        :cartridge-product-out,
        :intake-seawater-in ;
    watr:hasMember :antiscalant-addition,
        :backwash-handling,
        :cartridge-filtration,
        :chlorination,
        :ferric-chloride-addition,
        :intake,
        :media-filtration,
        :static-mixer,
        :storage-tank-1 .

<https://watermetadata.org/ontology/watr> owl:versionInfo "0.2" .

:storage-tank-1-residence-time a watr:QuantifiableProperty ;
    rdfs:label "Nominal residence time" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 2e+00 ;
    ns2:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    ns2:hasUnit <http://qudt.org/vocab/unit/HR> .

:antiscalant-addition--cartridge-filtration a watr:Pipe ;
    rdfs:label "antiscalant-addition--cartridge-filtration" ;
    watr:connectsAt :antiscalant-addition-out,
        :cartridge-filtration-in ;
    watr:hasMedium ns1:Water-Seawater .

:antiscalant-addition-in a watr:InletConnectionPoint ;
    rdfs:label "antiscalant-addition-in" ;
    watr:connectsThrough :media-product-out--antiscalant-addition ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :antiscalant-addition .

:antiscalant-addition-out a watr:OutletConnectionPoint ;
    rdfs:label "antiscalant-addition-out" ;
    watr:connectsThrough :antiscalant-addition--cartridge-filtration ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :antiscalant-addition .

:backwash-handling-in a watr:InletConnectionPoint ;
    rdfs:label "backwash-handling-in" ;
    watr:connectsThrough :s06 ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :backwash-handling .

:backwash-out a watr:OutletConnectionPoint ;
    rdfs:label "backwash-out" ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :backwash-handling .

:cartridge-filtration-in a watr:InletConnectionPoint ;
    rdfs:label "cartridge-filtration-in" ;
    watr:connectsThrough :antiscalant-addition--cartridge-filtration ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :cartridge-filtration .

:cartridge-product-out a watr:OutletConnectionPoint ;
    rdfs:label "cartridge-product-out" ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :cartridge-filtration .

:chlorination--static-mixer a watr:Pipe ;
    rdfs:label "chlorination--static-mixer" ;
    watr:connectsAt :chlorination-out,
        :static-mixer-in ;
    watr:hasMedium ns1:Water-Seawater .

:chlorination-in a watr:InletConnectionPoint ;
    rdfs:label "chlorination-in" ;
    watr:connectsThrough :ferric-chloride-addition--chlorination ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :chlorination .

:chlorination-out a watr:OutletConnectionPoint ;
    rdfs:label "chlorination-out" ;
    watr:connectsThrough :chlorination--static-mixer ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :chlorination .

:ferric-chloride-addition--chlorination a watr:Pipe ;
    rdfs:label "ferric-chloride-addition--chlorination" ;
    watr:connectsAt :chlorination-in,
        :ferric-chloride-addition-out ;
    watr:hasMedium ns1:Water-Seawater .

:ferric-chloride-addition-in a watr:InletConnectionPoint ;
    rdfs:label "ferric-chloride-addition-in" ;
    watr:connectsThrough :intake--ferric-chloride-addition ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :ferric-chloride-addition .

:ferric-chloride-addition-out a watr:OutletConnectionPoint ;
    rdfs:label "ferric-chloride-addition-out" ;
    watr:connectsThrough :ferric-chloride-addition--chlorination ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :ferric-chloride-addition .

:intake--ferric-chloride-addition a watr:Pipe ;
    rdfs:label "intake--ferric-chloride-addition" ;
    watr:connectsAt :ferric-chloride-addition-in,
        :intake-out ;
    watr:hasMedium ns1:Water-Seawater .

:intake-out a watr:OutletConnectionPoint ;
    rdfs:label "intake-out" ;
    watr:connectsThrough :intake--ferric-chloride-addition ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :intake .

:intake-seawater-in a watr:InletConnectionPoint ;
    rdfs:label "intake-seawater-in" ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :intake .

:media-backwash-out a watr:OutletConnectionPoint ;
    rdfs:label "media-backwash-out" ;
    watr:connectsThrough :s06 ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :media-filtration .

:media-filtration-in a watr:InletConnectionPoint ;
    rdfs:label "media-filtration-in" ;
    watr:connectsThrough :storage-tank-1--media-filtration ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :media-filtration .

:media-product-out a watr:OutletConnectionPoint ;
    rdfs:label "media-product-out" ;
    watr:connectsThrough :media-product-out--antiscalant-addition ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :media-filtration .

:media-product-out--antiscalant-addition a watr:Pipe ;
    rdfs:label "media-product-out--antiscalant-addition" ;
    watr:connectsAt :antiscalant-addition-in,
        :media-product-out ;
    watr:hasMedium ns1:Water-Seawater .

:s06 a watr:Pipe ;
    rdfs:label "s06" ;
    watr:connectsAt :backwash-handling-in,
        :media-backwash-out ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:hasRole ns1:Role-Backwash .

:static-mixer--storage-tank-1 a watr:Pipe ;
    rdfs:label "static-mixer--storage-tank-1" ;
    watr:connectsAt :static-mixer-out,
        :storage-tank-1-in ;
    watr:hasMedium ns1:Water-Seawater .

:static-mixer-in a watr:InletConnectionPoint ;
    rdfs:label "static-mixer-in" ;
    watr:connectsThrough :chlorination--static-mixer ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :static-mixer .

:static-mixer-out a watr:OutletConnectionPoint ;
    rdfs:label "static-mixer-out" ;
    watr:connectsThrough :static-mixer--storage-tank-1 ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :static-mixer .

:storage-tank-1--media-filtration a watr:Pipe ;
    rdfs:label "storage-tank-1--media-filtration" ;
    watr:connectsAt :media-filtration-in,
        :storage-tank-1-out ;
    watr:hasMedium ns1:Water-Seawater .

:storage-tank-1-in a watr:InletConnectionPoint ;
    rdfs:label "storage-tank-1-in" ;
    watr:connectsThrough :static-mixer--storage-tank-1 ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :storage-tank-1 .

:storage-tank-1-out a watr:OutletConnectionPoint ;
    rdfs:label "storage-tank-1-out" ;
    watr:connectsThrough :storage-tank-1--media-filtration ;
    watr:hasMedium ns1:Water-Seawater ;
    watr:isConnectionPointOf :storage-tank-1 .

:antiscalant-addition a seawaterro:DosingStage ;
    rdfs:label "Antiscalant addition" ;
    watr:hasConnectionPoint :antiscalant-addition-in,
        :antiscalant-addition-out ;
    ns1:hasProcess ns1:Process-Dosing .

:backwash-handling a seawaterro:BackwashStage ;
    rdfs:label "Media-filter backwash handling" ;
    watr:hasConnectionPoint :backwash-handling-in,
        :backwash-out ;
    ns1:hasProcess ns1:Process-Backwashing .

:cartridge-filtration a seawaterro:CartridgeFiltrationStage ;
    rdfs:label "Cartridge filtration" ;
    watr:hasConnectionPoint :cartridge-filtration-in,
        :cartridge-product-out ;
    rdfs:comment "WaterTAP cartridge filtration zero-order unit model." ;
    ns1:hasProcess ns1:Process-Filtration .

:chlorination a seawaterro:ChlorinationStage ;
    rdfs:label "chlorination" ;
    watr:hasConnectionPoint :chlorination-in,
        :chlorination-out ;
    ns1:hasProcess ns1:Process-ChlorineDosing .

:ferric-chloride-addition a seawaterro:CoagulationStage ;
    rdfs:label "Ferric chloride addition" ;
    watr:hasConnectionPoint :ferric-chloride-addition-in,
        :ferric-chloride-addition-out ;
    ns1:hasProcess ns1:Process-Coagulation .

:intake a seawaterro:IntakePump ;
    rdfs:label "Seawater intake" ;
    watr:hasConnectionPoint :intake-out,
        :intake-seawater-in ;
    watr:hasRole ns1:Role-Feed .

:static-mixer a seawaterro:MixingStage ;
    rdfs:label "Static mixer" ;
    watr:hasConnectionPoint :static-mixer-in,
        :static-mixer-out ;
    ns1:hasProcess ns1:Process-Mixing .

:storage-tank-1 a seawaterro:StorageTank ;
    rdfs:label "Pretreatment storage tank" ;
    watr:hasConnectionPoint :storage-tank-1-in,
        :storage-tank-1-out ;
    watr:hasProperty :storage-tank-1-residence-time ;
    watr:hasRole ns1:Role-Storage .

:media-filtration a seawaterro:MediaFiltrationStage ;
    rdfs:label "Media filtration" ;
    watr:hasConnectionPoint :media-backwash-out,
        :media-filtration-in,
        :media-product-out ;
    rdfs:comment "WaterTAP media filtration zero-order unit model." ;
    ns1:hasProcess ns1:Process-MediaFiltration .

