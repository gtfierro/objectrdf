    rdfs:label "High-pressure pump P1" ;
    s223:hasConnectionPoint :pump-1-in,
        :pump-1-out ;
    s223:hasProperty :pump-1-efficiency,
        :pump-1-operating-pressure .

:pump-2 a seawaterro:BoosterPump ;
    rdfs:label "Booster pump P2" ;
    s223:hasConnectionPoint :pump-2-in,
        :pump-2-out ;
    s223:hasProperty :pump-2-efficiency .

:pxr-brine-in a s223:InletConnectionPoint ;
    rdfs:label "pxr-brine-in" ;
    s223:connectsThrough :ro-concentrate--pxr-brine-connection-in ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :pressure-exchanger ;
    s223:pairedConnectionPoint :pxr-brine-out .

:pxr-brine-out a s223:OutletConnectionPoint ;
    rdfs:label "pxr-brine-out" ;
    s223:connectsThrough :pxr-brine-connection-out ;
    s223:hasMedium s223:Fluid-Water ;
