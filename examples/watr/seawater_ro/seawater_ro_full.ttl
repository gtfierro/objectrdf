@prefix : <urn:example/watertap/seawater-ro/full#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix watr: <urn:nawi-water-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:example/watertap/seawater-ro/full> a owl:Ontology ;
    rdfs:label "WaTr seawater RO reference" ;
    owl:imports <http://qudt.org/3.4.0/qudt-all>,
        <urn:nawi-water-ontology> .

:antiscalant-addition-process a watr:Process-ChemicalAddition ;
    rdfs:label "antiscalant-addition-process" ;
    skos:definition "Add antiscalant before cartridge filtration." .

:backwash-handling-process a watr:Process-Separation ;
    rdfs:label "backwash-handling-process" ;
    skos:definition "Separate media-filter backwash into treated water and a solids-rich byproduct." .

:cartridge-filtration-process a watr:Process-Filtration ;
    rdfs:label "cartridge-filtration-process" ;
    skos:definition "Polish the pretreated seawater by cartridge filtration." .

:chlorination-process a watr:Process-Chlorination ;
    rdfs:label "chlorination-process" ;
    skos:definition "Disinfect the seawater by chlorination." .

:co2-addition-process a watr:Process-ChemicalAddition ;
    rdfs:label "co2-addition-process" ;
    skos:definition "Add carbon dioxide during remineralization." .

:disposal a s223:Equipment ;
    rdfs:label "Brine disposal" ;
    s223:hasConnectionPoint :disposal-in ;
    s223:hasRole s223:Role-Discharge .

:feed a s223:Equipment ;
    rdfs:label "Seawater feed" ;
    s223:hasConnectionPoint :feed-seawater-out ;
    s223:hasRole watr:Role-Feed .

:ferric-chloride-addition-process a watr:Process-Coagulation ;
    rdfs:label "ferric-chloride-addition-process" ;
    skos:definition "Add 20 mg/L ferric chloride to promote coagulation." .

:influent-flow-rate a s223:QuantifiableProperty ;
    rdfs:label "Influent flow rate" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 7.05e+06 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/VolumeFlowRate> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/GAL_US-PER-DAY> .

:influent-pressure a s223:QuantifiableProperty ;
    rdfs:label "Influent pressure" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+05 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Pressure> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/PA> .

:influent-tds-concentration a s223:QuantifiableProperty ;
    rdfs:label "Influent total dissolved solids concentration" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 3.5e+01 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-Salt ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassConcentration> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/GM-PER-L> .

:influent-temperature a s223:QuantifiableProperty ;
    rdfs:label "Influent temperature" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 2.98e+02 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Temperature> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/K> .

:influent-tss-concentration a s223:QuantifiableProperty ;
    rdfs:label "Influent total suspended solids concentration" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 3e-02 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-SuspendedSolids ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassConcentration> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/GM-PER-L> .

:landfill-process a watr:Process-Landfill ;
    rdfs:label "landfill-process" ;
    skos:definition "Dispose of the backwash solids by landfilling." .

:lime-addition-process a watr:Process-ChemicalAddition ;
    rdfs:label "lime-addition-process" ;
    skos:definition "Add 2.3 mg/L lime during remineralization." .

:media-filtration-process a watr:Process-MediaFiltration ;
    rdfs:label "media-filtration-process" ;
    skos:definition "Remove suspended matter by filtration through media." .

:municipal a s223:Equipment ;
    rdfs:label "Municipal distribution" ;
    s223:hasConnectionPoint :municipal-in ;
    s223:hasRole s223:Role-Supply .

:pressure-exchanger-efficiency a s223:QuantifiableProperty ;
    rdfs:label "Pressure-exchanger efficiency" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 9.5e-01 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Efficiency> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/UNITLESS> .

:pump-1-efficiency a s223:QuantifiableProperty ;
    rdfs:label "Pump efficiency" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 8e-01 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Efficiency> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/UNITLESS> .

:pump-1-operating-pressure a s223:QuantifiableProperty ;
    rdfs:label "Operating pressure" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 7e+06 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Pressure> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/PA> .

:pump-2-efficiency a s223:QuantifiableProperty ;
    rdfs:label "Pump efficiency" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 8e-01 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Efficiency> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/UNITLESS> .

:reverse-osmosis-channel-height a s223:QuantifiableProperty ;
    rdfs:label "Membrane channel height" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e-03 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Length> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/M> .

:reverse-osmosis-membrane-area a s223:QuantifiableProperty ;
    rdfs:label "Membrane area" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.3914e+04 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Area> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/M2> .

:reverse-osmosis-permeate-side-pressure a s223:QuantifiableProperty ;
    rdfs:label "Nominal permeate-side pressure" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.01325e+05 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Pressure> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/PA> .

:reverse-osmosis-process a watr:Process-ReverseOsmosis ;
    rdfs:label "reverse-osmosis-process" ;
    skos:definition "Separate pressurized seawater into freshwater permeate and brine." .

:reverse-osmosis-salt-permeability a s223:QuantifiableProperty ;
    rdfs:label "Salt permeability coefficient" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 3.5e-08 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Velocity> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/M-PER-SEC> .

:reverse-osmosis-spacer-porosity a s223:QuantifiableProperty ;
    rdfs:label "Feed spacer porosity" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 9.7e-01 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/DimensionlessRatio> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/UNITLESS> .

:reverse-osmosis-stage-width a s223:QuantifiableProperty ;
    rdfs:label "Membrane width per stage" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+03 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Length> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/M> .

:reverse-osmosis-water-permeability a s223:Property ;
    rdfs:label "Water permeability coefficient [m/(Pa·s)]" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 4.2e-12 .

:ro-feed-mixing-process a watr:Process-Mixing ;
    rdfs:label "ro-feed-mixing-process" ;
    skos:definition "Combine the P1 and pressure-exchanger feed streams." .

:static-mixing-process a watr:Process-Mixing ;
    rdfs:label "static-mixing-process" ;
    skos:definition "Mix added treatment chemicals into the seawater." .

:storage-tank-1-residence-time a s223:QuantifiableProperty ;
    rdfs:label "Nominal residence time" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 2e+00 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/HR> .

:storage-tank-2-residence-time a s223:QuantifiableProperty ;
    rdfs:label "Nominal residence time" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+00 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/HR> .

:storage-tank-3-residence-time a s223:QuantifiableProperty ;
    rdfs:label "Nominal residence time" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+00 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/HR> .

:uv-aop-process a watr:Process-AdvancedOxidation ;
    rdfs:label "uv-aop-process" ;
    skos:definition "Disinfect freshwater by UV advanced oxidation." .

:uv-aop-reduction-equivalent-dose a s223:QuantifiableProperty ;
    rdfs:label "Reduction-equivalent UV dose" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 3.5e-01 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/EnergyPerArea> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/J-PER-CentiM2> .

:uv-aop-transmittance a s223:QuantifiableProperty ;
    rdfs:label "UV transmittance" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 9.5e-01 ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Transmittance> ;
    qudt:hasUnit <http://qudt.org/vocab/unit/UNITLESS> .

:antiscalant-addition a watr:Reactor ;
    rdfs:label "Antiscalant addition" ;
    s223:hasConnectionPoint :antiscalant-addition-in,
        :antiscalant-addition-out ;
    watr:hasProcess :antiscalant-addition-process .

:antiscalant-addition--cartridge-filtration a s223:Pipe ;
    rdfs:label "antiscalant-addition--cartridge-filtration" ;
    s223:connectsAt :antiscalant-addition-out,
        :cartridge-filtration-in ;
    s223:hasMedium s223:Fluid-Water .

:antiscalant-addition-in a s223:InletConnectionPoint ;
    rdfs:label "antiscalant-addition-in" ;
    s223:connectsThrough :media-filtration--antiscalant-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :antiscalant-addition .

:antiscalant-addition-out a s223:OutletConnectionPoint ;
    rdfs:label "antiscalant-addition-out" ;
    s223:connectsThrough :antiscalant-addition--cartridge-filtration ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :antiscalant-addition .

:backwash-handling-byproduct-out a s223:OutletConnectionPoint ;
    rdfs:label "backwash-handling-byproduct-out" ;
    s223:connectsThrough :landfill-waste ;
    s223:hasMedium watr:Fluid-Sludge ;
    s223:isConnectionPointOf :backwash-handling .

:backwash-handling-in a s223:InletConnectionPoint ;
    rdfs:label "backwash-handling-in" ;
    s223:connectsThrough :pretreatment-backwash ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :backwash-handling .

:backwash-handling-treated-out a s223:OutletConnectionPoint ;
    rdfs:label "backwash-handling-treated-out" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :backwash-handling .

:cartridge-filtration a watr:CartridgeFiltrationUnit ;
    rdfs:label "Cartridge filtration" ;
    s223:hasConnectionPoint :cartridge-filtration-in,
        :cartridge-filtration-out ;
    watr:hasProcess :cartridge-filtration-process .

:cartridge-filtration--pretreatment-to-desalination-boundary a s223:Pipe ;
    rdfs:label "cartridge-filtration--pretreatment-to-desalination-boundary" ;
    s223:connectsAt :cartridge-filtration-out,
        :pretreatment-to-desalination-boundary-in ;
    s223:hasMedium s223:Fluid-Water .

:cartridge-filtration-in a s223:InletConnectionPoint ;
    rdfs:label "cartridge-filtration-in" ;
    s223:connectsThrough :antiscalant-addition--cartridge-filtration ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :cartridge-filtration .

:cartridge-filtration-out a s223:OutletConnectionPoint ;
    rdfs:label "cartridge-filtration-out" ;
    s223:connectsThrough :cartridge-filtration--pretreatment-to-desalination-boundary ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :cartridge-filtration .

:chlorination a watr:ChlorinationUnit ;
    rdfs:label "chlorination" ;
    s223:hasConnectionPoint :chlorination-in,
        :chlorination-out ;
    watr:hasProcess :chlorination-process .

:chlorination--static-mixer a s223:Pipe ;
    rdfs:label "chlorination--static-mixer" ;
    s223:connectsAt :chlorination-out,
        :static-mixer-in ;
    s223:hasMedium s223:Fluid-Water .

:chlorination-in a s223:InletConnectionPoint ;
    rdfs:label "chlorination-in" ;
    s223:connectsThrough :ferric-chloride-addition--chlorination ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :chlorination .

:chlorination-out a s223:OutletConnectionPoint ;
    rdfs:label "chlorination-out" ;
    s223:connectsThrough :chlorination--static-mixer ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :chlorination .

:co2-addition a watr:Reactor ;
    rdfs:label "Carbon dioxide addition" ;
    s223:hasConnectionPoint :co2-addition-in,
        :co2-addition-out ;
    watr:hasProcess :co2-addition-process .

:co2-addition--lime-addition a s223:Pipe ;
    rdfs:label "co2-addition--lime-addition" ;
    s223:connectsAt :co2-addition-out,
        :lime-addition-in ;
    s223:hasMedium s223:Fluid-Water .

:co2-addition-in a s223:InletConnectionPoint ;
    rdfs:label "co2-addition-in" ;
    s223:connectsThrough :uv-aop--co2-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :co2-addition .

:co2-addition-out a s223:OutletConnectionPoint ;
    rdfs:label "co2-addition-out" ;
    s223:connectsThrough :co2-addition--lime-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :co2-addition .

:desalination-to-posttreatment-boundary a s223:Equipment ;
    rdfs:label "Desalination-to-posttreatment semantic boundary" ;
    s223:hasConnectionPoint :desalination-to-posttreatment-boundary-in,
        :desalination-to-posttreatment-boundary-out ;
    s223:hasRole watr:Role-Posttreatment .

:desalination-to-posttreatment-boundary--storage-tank-2 a s223:Pipe ;
    rdfs:label "desalination-to-posttreatment-boundary--storage-tank-2" ;
    s223:connectsAt :desalination-to-posttreatment-boundary-out,
        :storage-tank-2-in ;
    s223:hasMedium s223:Fluid-Water .

:desalination-to-posttreatment-boundary-in a s223:InletConnectionPoint ;
    rdfs:label "desalination-to-posttreatment-boundary-in" ;
    s223:connectsThrough :ro-permeate ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :desalination-to-posttreatment-boundary .

:desalination-to-posttreatment-boundary-out a s223:OutletConnectionPoint ;
    rdfs:label "desalination-to-posttreatment-boundary-out" ;
    s223:connectsThrough :desalination-to-posttreatment-boundary--storage-tank-2 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :desalination-to-posttreatment-boundary .

:disposal-in a s223:InletConnectionPoint ;
    rdfs:label "disposal-in" ;
    s223:connectsThrough :pxr-brine-connection-out ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :disposal .

:feed--intake a s223:Pipe ;
    rdfs:label "feed--intake" ;
    s223:connectsAt :feed-seawater-out,
        :intake-in ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasRole watr:Role-Feed .

:feed-seawater-out a s223:OutletConnectionPoint ;
    rdfs:label "feed-seawater-out" ;
    s223:connectsThrough :feed--intake ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :influent-flow-rate,
        :influent-pressure,
        :influent-tds-concentration,
        :influent-temperature,
        :influent-tss-concentration ;
    s223:isConnectionPointOf :feed .

:ferric-chloride-addition a watr:CoagulationBasin ;
    rdfs:label "Ferric chloride addition" ;
    s223:hasConnectionPoint :ferric-chloride-addition-in,
        :ferric-chloride-addition-out ;
    watr:hasProcess :ferric-chloride-addition-process .

:ferric-chloride-addition--chlorination a s223:Pipe ;
    rdfs:label "ferric-chloride-addition--chlorination" ;
    s223:connectsAt :chlorination-in,
        :ferric-chloride-addition-out ;
    s223:hasMedium s223:Fluid-Water .

:ferric-chloride-addition-in a s223:InletConnectionPoint ;
    rdfs:label "ferric-chloride-addition-in" ;
    s223:connectsThrough :intake--ferric-chloride-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :ferric-chloride-addition .

:ferric-chloride-addition-out a s223:OutletConnectionPoint ;
    rdfs:label "ferric-chloride-addition-out" ;
    s223:connectsThrough :ferric-chloride-addition--chlorination ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :ferric-chloride-addition .

:intake a watr:Pump ;
    rdfs:label "Seawater intake" ;
    s223:hasConnectionPoint :intake-in,
        :intake-out ;
    s223:hasRole watr:Role-Feed .

:intake--ferric-chloride-addition a s223:Pipe ;
    rdfs:label "intake--ferric-chloride-addition" ;
    s223:connectsAt :ferric-chloride-addition-in,
        :intake-out ;
    s223:hasMedium s223:Fluid-Water .

:intake-in a s223:InletConnectionPoint ;
    rdfs:label "intake-in" ;
    s223:connectsThrough :feed--intake ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :intake .

:intake-out a s223:OutletConnectionPoint ;
    rdfs:label "intake-out" ;
    s223:connectsThrough :intake--ferric-chloride-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :intake .

:landfill a watr:UnitProcess ;
    rdfs:label "Landfill" ;
    s223:hasConnectionPoint :landfill-in,
        :landfill-out ;
    s223:hasOptionalConnectionPoint :landfill-out ;
    s223:hasRole watr:Role-SolidsHandling ;
    watr:hasProcess :landfill-process .

:landfill-in a s223:InletConnectionPoint ;
    rdfs:label "landfill-in" ;
    s223:connectsThrough :landfill-waste ;
    s223:hasMedium watr:Fluid-Sludge ;
    s223:isConnectionPointOf :landfill .

:landfill-out a s223:OutletConnectionPoint ;
    rdfs:label "landfill-out" ;
    s223:hasMedium watr:Fluid-Sludge ;
    s223:isConnectionPointOf :landfill .

:landfill-waste a s223:Pipe ;
    rdfs:label "landfill-waste" ;
    s223:connectsAt :backwash-handling-byproduct-out,
        :landfill-in ;
    s223:hasMedium watr:Fluid-Sludge ;
    s223:hasRole watr:Role-SolidsHandling .

:lime-addition a watr:Reactor ;
    rdfs:label "Lime addition" ;
    s223:hasConnectionPoint :lime-addition-in,
        :lime-addition-out ;
    watr:hasProcess :lime-addition-process .

:lime-addition--storage-tank-3 a s223:Pipe ;
    rdfs:label "lime-addition--storage-tank-3" ;
    s223:connectsAt :lime-addition-out,
        :storage-tank-3-in ;
    s223:hasMedium s223:Fluid-Water .

:lime-addition-in a s223:InletConnectionPoint ;
    rdfs:label "lime-addition-in" ;
    s223:connectsThrough :co2-addition--lime-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :lime-addition .

:lime-addition-out a s223:OutletConnectionPoint ;
    rdfs:label "lime-addition-out" ;
    s223:connectsThrough :lime-addition--storage-tank-3 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :lime-addition .

:media-filtration--antiscalant-addition a s223:Pipe ;
    rdfs:label "media-filtration--antiscalant-addition" ;
    s223:connectsAt :antiscalant-addition-in,
        :media-filtration-product-out ;
    s223:hasMedium s223:Fluid-Water .

:media-filtration-backwash-out a s223:OutletConnectionPoint ;
    rdfs:label "media-filtration-backwash-out" ;
    s223:connectsThrough :pretreatment-backwash ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :media-filtration .

:media-filtration-in a s223:InletConnectionPoint ;
    rdfs:label "media-filtration-in" ;
    s223:connectsThrough :storage-tank-1--media-filtration ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :media-filtration .

:media-filtration-product-out a s223:OutletConnectionPoint ;
    rdfs:label "media-filtration-product-out" ;
    s223:connectsThrough :media-filtration--antiscalant-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :media-filtration .

:mixer-1-out a s223:OutletConnectionPoint ;
    rdfs:label "mixer-1-out" ;
    s223:connectsThrough :ro-feed ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :mixer-1 .

:mixer-1-pump-1-in a s223:InletConnectionPoint ;
    rdfs:label "mixer-1-pump-1-in" ;
    s223:connectsThrough :pump-1--mixer-1 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :mixer-1 .

:mixer-1-pump-2-in a s223:InletConnectionPoint ;
    rdfs:label "mixer-1-pump-2-in" ;
    s223:connectsThrough :pump-2--mixer-1 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :mixer-1 .

:municipal-in a s223:InletConnectionPoint ;
    rdfs:label "municipal-in" ;
    s223:connectsThrough :municipal-supply ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :municipal .

:municipal-supply a s223:Pipe ;
    rdfs:label "municipal-supply" ;
    s223:connectsAt :municipal-in,
        :storage-tank-3-out ;
