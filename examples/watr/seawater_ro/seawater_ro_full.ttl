:uv-aop a seawaterro:AdvancedOxidationStage ;
    rdfs:label "UV advanced oxidation process" ;
    s223:hasConnectionPoint :uv-aop-in,
        :uv-aop-out ;
    s223:hasProperty :uv-aop-reduction-equivalent-dose,
        :uv-aop-transmittance ;
    watr:hasProcess watr:Process-AdvancedOxidation .

:backwash-handling a seawaterro:BackwashSeparator ;
    rdfs:label "Media-filter backwash handling" ;
    s223:hasConnectionPoint :backwash-handling-byproduct,
        :backwash-handling-inlet,
        :backwash-handling-treated ;
    watr:hasProcess watr:Process-Separation .

:media-filtration a seawaterro:MediaFilter ;
    rdfs:label "Media filtration" ;
    s223:hasConnectionPoint :media-filtration-backwash,
        :media-filtration-inlet,
        :media-filtration-product ;
    watr:hasProcess watr:Process-MediaFiltration .

:mixer-1 a seawaterro:ROFeedMixer ;
    rdfs:label "RO feed mixer M1" ;
    s223:hasConnectionPoint :mixer-1-booster,
        :mixer-1-high_pressure,
        :mixer-1-outlet ;
    watr:hasProcess watr:Process-Mixing .

:reverse-osmosis a seawaterro:ROStage ;
    rdfs:label "Reverse osmosis" ;
    s223:hasConnectionPoint :reverse-osmosis-concentrate,
        :reverse-osmosis-inlet,
        :reverse-osmosis-permeate ;
    s223:hasProperty :reverse-osmosis-channel-height,
        :reverse-osmosis-membrane-area,
        :reverse-osmosis-salt-permeability,
        :reverse-osmosis-spacer-porosity,
        :reverse-osmosis-stage-width,
        :reverse-osmosis-water-permeability ;
    watr:hasProcess watr:Process-ReverseOsmosis .

:separator-1 a seawaterro:FeedSplitter ;
    rdfs:label "Feed separator S1" ;
    s223:hasConnectionPoint :separator-1-inlet,
        :separator-1-pressure_exchanger,
        :separator-1-pump ;
    s223:hasMedium s223:Fluid-Water ;
    rdfs:comment "IDAES stream splitter; this junction performs no treatment process." .

:pressure-exchanger a seawaterro:EnergyRecoveryExchanger ;
    rdfs:label "Pressure exchanger PXR" ;
    s223:hasConnectionPoint :pxr-brine-in,
        :pxr-brine-out,
        :pxr-feed-in,
        :pxr-feed-out ;
    s223:hasProperty :pressure-exchanger-efficiency .

