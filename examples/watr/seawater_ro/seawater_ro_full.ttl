:landfill a seawaterro:Landfill ;
    rdfs:label "Landfill" ;
    s223:hasConnectionPoint :landfill-inlet,
        :landfill-outlet .

:lime-addition a seawaterro:DosingStage ;
    rdfs:label "Lime addition" ;
    s223:hasConnectionPoint :lime-addition-in,
        :lime-addition-out ;
    watr:hasProcess watr:Process-Dosing .

