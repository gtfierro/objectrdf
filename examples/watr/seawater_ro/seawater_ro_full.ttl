:storage-tank-2-out a s223:OutletConnectionPoint ;
    rdfs:label "storage-tank-2-out" ;
    s223:connectsThrough :storage-tank-2--uv-aop ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :storage-tank-2 .

:storage-tank-3-in a s223:InletConnectionPoint ;
    rdfs:label "storage-tank-3-in" ;
    s223:connectsThrough :lime-addition--storage-tank-3 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :storage-tank-3 .

:storage-tank-3-out a s223:OutletConnectionPoint ;
    rdfs:label "storage-tank-3-out" ;
    s223:connectsThrough :municipal-supply ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :storage-tank-3 .

:uv-aop--co2-addition a s223:Pipe ;
    rdfs:label "uv-aop--co2-addition" ;
    s223:connectsAt :co2-addition-in,
