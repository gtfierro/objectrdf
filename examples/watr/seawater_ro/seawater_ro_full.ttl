    s223:connectsThrough :uv-aop--co2-addition ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :uv-aop .

:antiscalant-addition a seawaterro:DosingStage ;
    rdfs:label "Antiscalant addition" ;
    s223:hasConnectionPoint :antiscalant-addition-in,
