    rdfs:label "Pretreatment storage tank" ;
    s223:hasConnectionPoint :storage-tank-1-in,
        :storage-tank-1-out ;
    s223:hasProperty :storage-tank-1-residence-time ;
    s223:hasRole watr:Role-Storage .

:storage-tank-2 a seawaterro:StorageTank ;
    rdfs:label "Post-treatment storage tank 2" ;
    s223:hasConnectionPoint :storage-tank-2-in,
        :storage-tank-2-out ;
    s223:hasProperty :storage-tank-2-residence-time ;
    s223:hasRole watr:Role-Storage .

:storage-tank-3 a seawaterro:StorageTank ;
