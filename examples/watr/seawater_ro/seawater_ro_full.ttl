    s223:hasProperty :reverse-osmosis-permeate-side-pressure ;
    s223:hasRole s223:Role-Supply,
        watr:Role-Permeate .

:separator-1--pump-1 a s223:Pipe ;
    rdfs:label "separator-1--pump-1" ;
    s223:connectsAt :pump-1-in,
        :separator-1-pump ;
    s223:hasMedium s223:Fluid-Water .

:separator-1-inlet a s223:InletConnectionPoint ;
