@prefix : <urn:example/treatment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .

<urn:example/treatment> a owl:Ontology ;
    owl:imports <https://watermetadata.org/ontology/watr> .

:treatment-system a s223:System ;
    rdfs:label "treatment-system" ;
    s223:hasMember :product-tank,
        :transfer-pump,
        :water-source .

<https://watermetadata.org/ontology/watr> owl:versionInfo "0.2" .

:product-tank-out a s223:OutletConnectionPoint ;
    rdfs:label "product-tank-out" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :product-tank .

:water-source-in a s223:InletConnectionPoint ;
    rdfs:label "water-source-in" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :water-source .

:product-tank-in a s223:InletConnectionPoint ;
    rdfs:label "product-tank-in" ;
    s223:connectsThrough :transfer-pump--product-tank ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :product-tank .

:transfer-pump--product-tank a s223:Pipe ;
    rdfs:label "transfer-pump--product-tank" ;
    s223:connectsAt :product-tank-in,
        :transfer-pump-out ;
    s223:hasMedium s223:Fluid-Water .

:transfer-pump-in a s223:InletConnectionPoint ;
    rdfs:label "transfer-pump-in" ;
    s223:connectsThrough :water-source--transfer-pump ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :transfer-pump .

:transfer-pump-out a s223:OutletConnectionPoint ;
    rdfs:label "transfer-pump-out" ;
    s223:connectsThrough :transfer-pump--product-tank ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :transfer-pump .

:water-source--transfer-pump a s223:Pipe ;
    rdfs:label "water-source--transfer-pump" ;
    s223:connectsAt :transfer-pump-in,
        :water-source-out ;
    s223:hasMedium s223:Fluid-Water .

:water-source-out a s223:OutletConnectionPoint ;
    rdfs:label "water-source-out" ;
    s223:connectsThrough :water-source--transfer-pump ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :water-source .

:product-tank a watr:Tank ;
    rdfs:label "product-tank" ;
    s223:hasConnectionPoint :product-tank-in,
        :product-tank-out .

:transfer-pump a watr:Pump ;
    rdfs:label "transfer-pump" ;
    s223:hasConnectionPoint :transfer-pump-in,
        :transfer-pump-out .

:water-source a s223:Chiller ;
    rdfs:label "water-source" ;
    s223:hasConnectionPoint :water-source-in,
        :water-source-out .

