@prefix : <urn:example/treatment#> .
@prefix drinking-water: <https://w3id.org/plumb/drinking-water#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .

<urn:example/treatment> a owl:Ontology ;
    rdfs:label "Conventional surface-water treatment train" ;
    owl:imports drinking-water:,
        <https://watermetadata.org/ontology/watr> .

:treatment-system a s223:System ;
    rdfs:label "treatment-system" ;
    s223:hasBoundaryConnectionPoint :chlorination-contact-outlet,
        :clarifier-sludge,
        :coagulation-inlet,
        :sand-filter-backwash_supply,
        :sand-filter-backwash_waste ;
    s223:hasMember :chlorination-contact,
        :clarifier,
        :coagulation,
        :flocculation,
        :sand-filter .

<https://watermetadata.org/ontology/watr> owl:versionInfo "0.3.rc1" .

:chlorination-contact-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :filtered-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :chlorination-contact .

:chlorination-contact-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :chlorination-contact .

:clarified-water a s223:Pipe ;
    rdfs:label "clarified-water" ;
    s223:connectsAt :clarifier-clarified_water,
        :sand-filter-inlet ;
    s223:hasMedium s223:Fluid-Water .

:clarifier-clarified_water a s223:OutletConnectionPoint ;
    rdfs:label "clarified_water" ;
    s223:connectsThrough :clarified-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :clarifier .

:clarifier-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :flocculated-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :clarifier .

:clarifier-sludge a s223:OutletConnectionPoint ;
    rdfs:label "sludge" ;
    s223:hasMedium watr:Fluid-Sludge ;
    s223:isConnectionPointOf :clarifier .

:coagulated-water a s223:Pipe ;
    rdfs:label "coagulated-water" ;
    s223:connectsAt :coagulation-outlet,
        :flocculation-inlet ;
    s223:hasMedium s223:Fluid-Water .

:coagulation-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :coagulation .

:coagulation-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :coagulated-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :coagulation .

:filtered-water a s223:Pipe ;
    rdfs:label "filtered-water" ;
    s223:connectsAt :chlorination-contact-inlet,
        :sand-filter-filtered_water ;
    s223:hasMedium s223:Fluid-Water .

:flocculated-water a s223:Pipe ;
    rdfs:label "flocculated-water" ;
    s223:connectsAt :clarifier-inlet,
        :flocculation-outlet ;
    s223:hasMedium s223:Fluid-Water .

:flocculation-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :coagulated-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :flocculation .

:flocculation-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :flocculated-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :flocculation .

:sand-filter-backwash_supply a s223:InletConnectionPoint ;
    rdfs:label "backwash_supply" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :sand-filter .

:sand-filter-backwash_waste a s223:OutletConnectionPoint ;
    rdfs:label "backwash_waste" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :sand-filter .

:sand-filter-filtered_water a s223:OutletConnectionPoint ;
    rdfs:label "filtered_water" ;
    s223:connectsThrough :filtered-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :sand-filter .

:sand-filter-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :clarified-water ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :sand-filter .

:chlorination-contact a drinking-water:ChlorinationStage ;
    rdfs:label "chlorination-contact" ;
    s223:hasConnectionPoint :chlorination-contact-inlet,
        :chlorination-contact-outlet ;
    watr:hasProcess watr:Process-Chlorination ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Disinfection .

:coagulation a drinking-water:CoagulationStage ;
    rdfs:label "coagulation" ;
    s223:hasConnectionPoint :coagulation-inlet,
        :coagulation-outlet ;
    watr:hasProcess watr:Process-Coagulation ;
    watr:hasTreatmentObjective watr:TreatmentObjective-TurbidityRemoval .

:flocculation a drinking-water:FlocculationStage ;
    rdfs:label "flocculation" ;
    s223:hasConnectionPoint :flocculation-inlet,
        :flocculation-outlet ;
    watr:hasProcess watr:Process-Flocculation ;
    watr:hasTreatmentObjective watr:TreatmentObjective-TurbidityRemoval .

:clarifier a drinking-water:ClarificationStage ;
    rdfs:label "clarifier" ;
    s223:hasConnectionPoint :clarifier-clarified_water,
        :clarifier-inlet,
        :clarifier-sludge ;
    watr:hasProcess watr:Process-Settling ;
    watr:hasTreatmentObjective watr:TreatmentObjective-Clarification .

:sand-filter a drinking-water:RapidSandFiltrationStage ;
    rdfs:label "sand-filter" ;
    s223:hasConnectionPoint :sand-filter-backwash_supply,
        :sand-filter-backwash_waste,
        :sand-filter-filtered_water,
        :sand-filter-inlet ;
    watr:hasProcess watr:Process-RapidSandFiltration ;
    watr:hasTreatmentObjective watr:TreatmentObjective-TurbidityRemoval .

