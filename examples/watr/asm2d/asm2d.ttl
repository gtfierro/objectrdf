@prefix : <urn:example/watertap/asm2d#> .
@prefix asm2d: <https://w3id.org/plumb/asm2d#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:example/watertap/asm2d> a owl:Ontology ;
    rdfs:label "WaterTAP ASM2d flowsheet" ;
    owl:imports <http://qudt.org/3.4.0/qudt-all>,
        asm2d:,
        <https://watermetadata.org/ontology/watr> .

:ASM2d-system a s223:System ;
    rdfs:label "WaterTAP ASM2d treatment train" ;
    s223:hasBoundaryConnectionPoint :CL1-effluent,
        :MX1-feed_water,
        :SP2-waste ;
    s223:hasMember :CL1,
        :MX1,
        :MX2,
        :P1,
        :R1,
        :R2,
        :R3,
        :R4,
        :R5,
        :R6,
        :R7,
        :SP1,
        :SP2 .

<https://watermetadata.org/ontology/watr> owl:versionInfo "0.3.rc1" .

:CL1-effluent-h2o-fraction a asm2d:SplitFraction ;
    rdfs:label "H2o fraction" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 4.8956e-01 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance s223:Constituent-H2O ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:UNITLESS ;
    asm2d:hasSplitBasis asm2d:ComponentMassFlow .

:CL1-effluent-tss-fraction a asm2d:SplitFraction ;
    rdfs:label "Tss fraction" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 2.194e-02 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-SuspendedSolids ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:UNITLESS ;
    asm2d:hasSplitBasis asm2d:ComponentMassFlow .

:P1-outlet-pressure a s223:QuantifiableProperty ;
    rdfs:label "Pressure" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.01325e+05 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:hasUnit unit:PA .

:R1-volume a s223:QuantifiableProperty ;
    rdfs:label "Volume" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+03 ;
    qudt:hasQuantityKind quantitykind:Volume ;
    qudt:hasUnit unit:M3 .

:R2-volume a s223:QuantifiableProperty ;
    rdfs:label "Volume" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+03 ;
    qudt:hasQuantityKind quantitykind:Volume ;
    qudt:hasUnit unit:M3 .

:R3-volume a s223:QuantifiableProperty ;
    rdfs:label "Volume" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+03 ;
    qudt:hasQuantityKind quantitykind:Volume ;
    qudt:hasUnit unit:M3 .

:R4-volume a s223:QuantifiableProperty ;
    rdfs:label "Volume" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+03 ;
    qudt:hasQuantityKind quantitykind:Volume ;
    qudt:hasUnit unit:M3 .

:R5-outlet-oxygen-concentration a s223:QuantifiableProperty ;
    rdfs:label "Oxygen concentration" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.91e+00 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-DissolvedOxygen ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:R5-oxygen-transfer-coefficient a s223:QuantifiableProperty ;
    rdfs:label "Oxygen transfer coefficient" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+01 ;
    qudt:hasQuantityKind quantitykind:Frequency ;
    qudt:hasUnit unit:PER-HR .

:R5-volume a s223:QuantifiableProperty ;
    rdfs:label "Volume" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.333e+03 ;
    qudt:hasQuantityKind quantitykind:Volume ;
    qudt:hasUnit unit:M3 .

:R6-outlet-oxygen-concentration a s223:QuantifiableProperty ;
    rdfs:label "Oxygen concentration" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 2.6e+00 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-DissolvedOxygen ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:R6-oxygen-transfer-coefficient a s223:QuantifiableProperty ;
    rdfs:label "Oxygen transfer coefficient" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e+01 ;
    qudt:hasQuantityKind quantitykind:Frequency ;
    qudt:hasUnit unit:PER-HR .

:R6-volume a s223:QuantifiableProperty ;
    rdfs:label "Volume" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.333e+03 ;
    qudt:hasQuantityKind quantitykind:Volume ;
    qudt:hasUnit unit:M3 .

:R7-outlet-oxygen-concentration a s223:QuantifiableProperty ;
    rdfs:label "Oxygen concentration" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 3.2e+00 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-DissolvedOxygen ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:R7-oxygen-transfer-coefficient a s223:QuantifiableProperty ;
    rdfs:label "Oxygen transfer coefficient" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 3.5e+00 ;
    qudt:hasQuantityKind quantitykind:Frequency ;
    qudt:hasUnit unit:PER-HR .

:R7-volume a s223:QuantifiableProperty ;
    rdfs:label "Volume" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.333e+03 ;
    qudt:hasQuantityKind quantitykind:Volume ;
    qudt:hasUnit unit:M3 .

:SP1-underflow-fraction a asm2d:SplitFraction ;
    rdfs:label "Fraction" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 6e-01 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:UNITLESS ;
    asm2d:hasSplitBasis asm2d:OverallFlow .

:SP2-recycle-fraction a asm2d:SplitFraction ;
    rdfs:label "Fraction" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 9.7955e-01 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:UNITLESS ;
    asm2d:hasSplitBasis asm2d:OverallFlow .

:feed-flow-rate a s223:QuantifiableProperty ;
    rdfs:label "Flow rate" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.8446e+04 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind quantitykind:VolumeFlowRate ;
    qudt:hasUnit unit:M3-PER-DAY .

:feed-pressure a s223:QuantifiableProperty ;
    rdfs:label "Pressure" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.01325e+05 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:hasUnit unit:PA .

