    watr:connectsThrough :stream5 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :MX2 .

:MX2-reactor a watr:InletConnectionPoint ;
    rdfs:label "reactor" ;
    watr:connectsThrough :stream4 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :MX2 .

:P1-inlet a watr:InletConnectionPoint ;
    rdfs:label "inlet" ;
    watr:connectsThrough :stream16 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :P1 .

