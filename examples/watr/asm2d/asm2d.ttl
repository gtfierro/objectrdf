    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-S_PO4 ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-temperature a s223:QuantifiableProperty ;
    rdfs:label "Temperature" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 2.9815e+02 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:K .

:feed-x_aut-concentration a s223:QuantifiableProperty ;
