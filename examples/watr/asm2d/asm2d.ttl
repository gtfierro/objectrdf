@prefix : <urn:example/watertap/asm2d#> .
@prefix asm2d: <https://w3id.org/objectrdf/asm2d#> .
@prefix ns1: <http://qudt.org/schema/qudt/> .
@prefix ns2: <https://watermetadata.org/ontology/watr#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix watr: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:example/watertap/asm2d> a owl:Ontology ;
    rdfs:label "WaterTAP ASM2d flowsheet" ;
    owl:imports <http://qudt.org/3.4.0/qudt-all>,
        asm2d:,
        <https://watermetadata.org/ontology/watr> .

:ASM2d-system a watr:System ;
    rdfs:label "WaterTAP ASM2d treatment train" ;
    watr:hasBoundaryConnectionPoint :CL1-effluent,
        :MX1-feed_water,
        :SP2-waste ;
    watr:hasMember :CL1,
        :MX1,
        :MX2,
        :P1,
        :R1,
        :R2,
        :R3,
        :R4,
        :R5,
        :R6,
        :R7,
        :SP1,
        :SP2 .

<https://watermetadata.org/ontology/watr> owl:versionInfo "0.2" .

:CL1-effluent-h2o-fraction a asm2d:SplitFraction ;
    rdfs:label "H2o fraction" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 4.8956e-01 ;
    watr:ofMedium watr:Fluid-Water ;
    watr:ofSubstance watr:Constituent-H2O ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/DimensionlessRatio> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/UNITLESS> ;
    asm2d:hasSplitBasis asm2d:ComponentMassFlow .

:CL1-effluent-tss-fraction a asm2d:SplitFraction ;
    rdfs:label "Tss fraction" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 2.194e-02 ;
    watr:ofMedium watr:Fluid-Water ;
    watr:ofSubstance ns2:Constituent-SuspendedSolids ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/DimensionlessRatio> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/UNITLESS> ;
    asm2d:hasSplitBasis asm2d:ComponentMassFlow .

:P1-outlet-pressure a watr:QuantifiableProperty ;
    rdfs:label "Pressure" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 1.01325e+05 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Pressure> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/PA> .

:R1-volume a watr:QuantifiableProperty ;
    rdfs:label "Volume" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 1e+03 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Volume> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/M3> .

:R2-volume a watr:QuantifiableProperty ;
    rdfs:label "Volume" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 1e+03 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Volume> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/M3> .

:R3-volume a watr:QuantifiableProperty ;
