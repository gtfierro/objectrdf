:SP1-underflow-fraction a asm2d:SplitFraction ;
    rdfs:label "Fraction" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 6e-01 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/DimensionlessRatio> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/UNITLESS> ;
    asm2d:hasSplitBasis asm2d:OverallFlow .

:SP2-recycle-fraction a asm2d:SplitFraction ;
    rdfs:label "Fraction" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 9.7955e-01 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/DimensionlessRatio> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/UNITLESS> ;
    asm2d:hasSplitBasis asm2d:OverallFlow .

:feed-flow-rate a watr:QuantifiableProperty ;
    rdfs:label "Flow rate" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 1.8446e+04 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/VolumeFlowRate> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/M3-PER-DAY> .

:feed-pressure a watr:QuantifiableProperty ;
