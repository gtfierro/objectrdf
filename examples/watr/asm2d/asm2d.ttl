    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 1e+01 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Frequency> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/PER-HR> .

