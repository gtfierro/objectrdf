    rdfs:label "Stored polyphosphate" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e-06 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-X_PP ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-x_s-concentration a s223:QuantifiableProperty ;
