    s223:hasValue 1e-06 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-X_MeP ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-x_pao-concentration a s223:QuantifiableProperty ;
    rdfs:label "Phosphate accumulating biomass" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e-06 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-X_PAO ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-x_pha-concentration a s223:QuantifiableProperty ;
    rdfs:label "Stored pha" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e-06 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-X_PHA ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
