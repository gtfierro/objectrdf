    s223:hasValue 1e-06 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance s223:Constituent-N2 ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-s_nh4-concentration a s223:QuantifiableProperty ;
    rdfs:label "Ammonia ammonium nitrogen" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1.6e+01 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-S_NH4 ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-s_no3-concentration a s223:QuantifiableProperty ;
    rdfs:label "Nitrate nitrite nitrogen" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e-06 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-S_NO3 ;
