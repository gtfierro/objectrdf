    watr:isConnectionPointOf :P1 .

:R1-inlet a watr:InletConnectionPoint ;
    rdfs:label "inlet" ;
    watr:connectsThrough :stream2 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :R1 .

