    watr:ofSubstance ns2:Constituent-DissolvedOxygen ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassConcentration> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/GM-PER-M3> .

:R6-oxygen-transfer-coefficient a watr:QuantifiableProperty ;
    rdfs:label "Oxygen transfer coefficient" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 1e+01 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Frequency> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/PER-HR> .

:R6-volume a watr:QuantifiableProperty ;
    rdfs:label "Volume" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 1.333e+03 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Volume> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/M3> .

:R7-outlet-oxygen-concentration a watr:QuantifiableProperty ;
    rdfs:label "Oxygen concentration" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 3.2e+00 ;
    watr:ofMedium watr:Fluid-Water ;
    watr:ofSubstance ns2:Constituent-DissolvedOxygen ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassConcentration> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/GM-PER-M3> .

:R7-oxygen-transfer-coefficient a watr:QuantifiableProperty ;
    rdfs:label "Oxygen transfer coefficient" ;
    watr:hasAspect watr:Aspect-Nominal ;
    watr:hasValue 3.5e+00 ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Frequency> ;
    ns1:hasUnit <http://qudt.org/vocab/unit/PER-HR> .

:R7-volume a watr:QuantifiableProperty ;
