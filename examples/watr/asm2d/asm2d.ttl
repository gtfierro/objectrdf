    s223:hasValue 7e+00 ;
    s223:ofMedium s223:Fluid-Water ;
    qudt:hasQuantityKind quantitykind:AmountOfSubstanceConcentration ;
    qudt:hasUnit unit:MOL-PER-M3 .

:feed-s_f-concentration a s223:QuantifiableProperty ;
