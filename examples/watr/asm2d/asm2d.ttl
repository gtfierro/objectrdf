:CL1-effluent a watr:OutletConnectionPoint ;
    rdfs:label "effluent" ;
    watr:hasMedium watr:Fluid-Water ;
    watr:hasProperty :CL1-effluent-h2o-fraction,
        :CL1-effluent-tss-fraction ;
    watr:isConnectionPointOf :CL1 .

:CL1-inlet a watr:InletConnectionPoint ;
    rdfs:label "inlet" ;
    watr:connectsThrough :stream11 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :CL1 .

:CL1-underflow a watr:OutletConnectionPoint ;
    rdfs:label "underflow" ;
    watr:connectsThrough :stream14 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :CL1 .

:MX1-feed_water a watr:InletConnectionPoint ;
    rdfs:label "feed_water" ;
    watr:hasMedium watr:Fluid-Water ;
    watr:hasProperty :feed-flow-rate,
        :feed-pressure,
        :feed-s_a-concentration,
        :feed-s_alk-concentration,
        :feed-s_f-concentration,
        :feed-s_i-concentration,
        :feed-s_n2-concentration,
        :feed-s_nh4-concentration,
        :feed-s_no3-concentration,
        :feed-s_o2-concentration,
        :feed-s_po4-concentration,
        :feed-temperature,
        :feed-x_aut-concentration,
        :feed-x_h-concentration,
        :feed-x_i-concentration,
        :feed-x_meoh-concentration,
        :feed-x_mep-concentration,
        :feed-x_pao-concentration,
        :feed-x_pha-concentration,
        :feed-x_pp-concentration,
        :feed-x_s-concentration,
        :feed-x_tss-concentration ;
    watr:isConnectionPointOf :MX1 .

:MX1-outlet a watr:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    watr:connectsThrough :stream2 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :MX1 .

:MX1-recycle a watr:InletConnectionPoint ;
    rdfs:label "recycle" ;
    watr:connectsThrough :stream17 ;
    watr:hasMedium watr:Fluid-Water ;
    watr:isConnectionPointOf :MX1 .

:MX2-internal_recycle a watr:InletConnectionPoint ;
