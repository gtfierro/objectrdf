    s223:hasValue 3e+01 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-X_H ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-x_i-concentration a s223:QuantifiableProperty ;
    rdfs:label "Inert particulate organics" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 2.5e+01 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-X_I ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-x_meoh-concentration a s223:QuantifiableProperty ;
    rdfs:label "Metal hydroxides" ;
    s223:hasAspect s223:Aspect-Nominal ;
    s223:hasValue 1e-06 ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-ASM2d-X_MeOH ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:GM-PER-M3 .

:feed-x_mep-concentration a s223:QuantifiableProperty ;
    rdfs:label "Metal phosphates" ;
