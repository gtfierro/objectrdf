:CL1-effluent a s223:OutletConnectionPoint ;
    rdfs:label "effluent" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :CL1-effluent-h2o-fraction,
        :CL1-effluent-tss-fraction ;
    s223:isConnectionPointOf :CL1 .

:CL1-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream11 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :CL1 .

:CL1-underflow a s223:OutletConnectionPoint ;
    rdfs:label "underflow" ;
    s223:connectsThrough :stream14 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :CL1 .

:MX1-feed_water a s223:InletConnectionPoint ;
    rdfs:label "feed_water" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :feed-flow-rate,
        :feed-pressure,
        :feed-s_a-concentration,
        :feed-s_alk-concentration,
        :feed-s_f-concentration,
        :feed-s_i-concentration,
        :feed-s_n2-concentration,
        :feed-s_nh4-concentration,
        :feed-s_no3-concentration,
        :feed-s_o2-concentration,
        :feed-s_po4-concentration,
        :feed-temperature,
        :feed-x_aut-concentration,
        :feed-x_h-concentration,
        :feed-x_i-concentration,
        :feed-x_meoh-concentration,
        :feed-x_mep-concentration,
        :feed-x_pao-concentration,
        :feed-x_pha-concentration,
        :feed-x_pp-concentration,
        :feed-x_s-concentration,
        :feed-x_tss-concentration ;
    s223:isConnectionPointOf :MX1 .

:MX1-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream2 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :MX1 .

:MX1-recycle a s223:InletConnectionPoint ;
    rdfs:label "recycle" ;
    s223:connectsThrough :stream17 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :MX1 .

:MX2-internal_recycle a s223:InletConnectionPoint ;
    rdfs:label "internal_recycle" ;
    s223:connectsThrough :stream12 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :MX2 .

:MX2-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream5 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :MX2 .

:MX2-reactor a s223:InletConnectionPoint ;
    rdfs:label "reactor" ;
    s223:connectsThrough :stream4 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :MX2 .

:P1-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream16 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :P1 .

:P1-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream17 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :P1-outlet-pressure ;
    s223:isConnectionPointOf :P1 .

:R1-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream2 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R1 .

:R1-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream3 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R1 .

:R2-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream3 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R2 .

:R2-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream4 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R2 .

:R3-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream5 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R3 .

:R3-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream6 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R3 .

:R4-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream6 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R4 .

:R4-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream7 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R4 .

:R5-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream7 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R5 .

:R5-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream8 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :R5-outlet-oxygen-concentration ;
    s223:isConnectionPointOf :R5 .

:R6-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream8 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R6 .

:R6-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream9 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :R6-outlet-oxygen-concentration ;
    s223:isConnectionPointOf :R6 .

:R7-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream9 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :R7 .

:R7-outlet a s223:OutletConnectionPoint ;
    rdfs:label "outlet" ;
    s223:connectsThrough :stream10 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :R7-outlet-oxygen-concentration ;
    s223:isConnectionPointOf :R7 .

:SP1-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream10 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :SP1 .

:SP1-overflow a s223:OutletConnectionPoint ;
    rdfs:label "overflow" ;
    s223:connectsThrough :stream11 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :SP1 .

:SP1-underflow a s223:OutletConnectionPoint ;
    rdfs:label "underflow" ;
    s223:connectsThrough :stream12 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :SP1-underflow-fraction ;
    s223:isConnectionPointOf :SP1 .

:SP2-inlet a s223:InletConnectionPoint ;
    rdfs:label "inlet" ;
    s223:connectsThrough :stream14 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :SP2 .

:SP2-recycle a s223:OutletConnectionPoint ;
    rdfs:label "recycle" ;
    s223:connectsThrough :stream16 ;
    s223:hasMedium s223:Fluid-Water ;
    s223:hasProperty :SP2-recycle-fraction ;
    s223:isConnectionPointOf :SP2 .

:SP2-waste a s223:OutletConnectionPoint ;
    rdfs:label "waste" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :SP2 .

:stream10 a s223:Pipe ;
    rdfs:label "stream10" ;
    s223:connectsAt :R7-outlet,
        :SP1-inlet ;
    s223:hasMedium s223:Fluid-Water .

:stream11 a s223:Pipe ;
    rdfs:label "stream11" ;
    s223:connectsAt :CL1-inlet,
