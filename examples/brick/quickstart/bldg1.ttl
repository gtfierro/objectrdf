@prefix : <urn:example/bldg1#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://w3id.org/rec#> .

<urn:example/bldg1> a owl:Ontology ;
    owl:imports <https://brickschema.org/schema/1.4/Brick> .

:bldg1 a rec:Building ;
    rdfs:label "Building 1" ;
    rec:hasPart :floor1 .

<https://brickschema.org/schema/1.4/Brick> owl:versionInfo "1.4.2" .

:floor1 a rec:Level ;
    rdfs:label "floor1" ;
    rec:hasPart :room101,
        :room102 .

:room102 a rec:Room ;
    rdfs:label "room102" .

:sat1 a brick:Supply_Air_Temperature_Sensor ;
    rdfs:label "sat1" ;
    brick:isPointOf :ahu1 .

:sf1 a brick:Supply_Fan ;
    rdfs:label "sf1" .

:vav-102 a brick:VAV ;
    rdfs:label "vav-102" ;
    brick:isFedBy :ahu1 .

:zat1 a brick:Zone_Air_Temperature_Sensor ;
    rdfs:label "zat1" ;
    brick:isPointOf :vav-101 .

:zone1 a rec:HVACZone ;
    rdfs:label "zone1" ;
    brick:isFedBy :vav-101 ;
    rec:hasPart :room101 .

:room101 a rec:Room ;
    rdfs:label "room101" .

:ahu1 a brick:AHU ;
    rdfs:label "Main AHU" ;
    brick:feeds :vav-101,
        :vav-102 ;
    brick:hasPoint :sat1 ;
    rec:hasPart :sf1 .

:vav-101 a brick:VAV ;
    rdfs:label "vav-101" ;
    brick:feeds :zone1 ;
    brick:hasPoint :zat1 ;
    brick:isFedBy :ahu1 .

