@prefix : <urn:example/ahu#> .
@prefix hvac: <https://w3id.org/objectrdf/hvac#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .

<urn:example/ahu> a owl:Ontology ;
    owl:imports <http://data.ashrae.org/standard223/1.0/model/all>,
        hvac: .

<http://data.ashrae.org/standard223/1.0/model/all> owl:versionInfo "git:master@6fdc11c60b930ccb042d775b66a9115547fd22a7 date:2026-10-06 20:01:58 UTC" .

:ahu-1-in a s223:InletConnectionPoint ;
    rdfs:label "ahu-1-in" ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :ahu-1 .

:ahu-1-out a s223:OutletConnectionPoint ;
    rdfs:label "ahu-1-out" ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :ahu-1 .

:chiller-in a s223:InletConnectionPoint ;
    rdfs:label "chiller-in" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :chiller .

:cooling-coil-air_outlet a s223:OutletConnectionPoint ;
    rdfs:label "air_outlet" ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :cooling-coil .

:cooling-coil-water_outlet a s223:OutletConnectionPoint ;
    rdfs:label "water_outlet" ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :cooling-coil .

:oa-damper-in a s223:InletConnectionPoint ;
    rdfs:label "oa-damper-in" ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :oa-damper .

:ahu-1 a s223:AirHandlingUnit ;
    rdfs:label "ahu-1" ;
    s223:contains :chiller,
        :cooling-coil,
        :oa-damper,
        :supply-fan ;
    s223:hasConnectionPoint :ahu-1-in,
        :ahu-1-out .

:chiller--cooling-coil-water_inlet a s223:Pipe ;
    rdfs:label "chiller--cooling-coil-water_inlet" ;
    s223:connectsAt :chiller-out,
        :cooling-coil-water_inlet ;
    s223:hasMedium s223:Fluid-Water .

:chiller-out a s223:OutletConnectionPoint ;
    rdfs:label "chiller-out" ;
    s223:connectsThrough :chiller--cooling-coil-water_inlet ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :chiller .

:cooling-coil-air_inlet a s223:InletConnectionPoint ;
    rdfs:label "air_inlet" ;
    s223:connectsThrough :supply-fan--cooling-coil-air_inlet ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :cooling-coil .

:cooling-coil-water_inlet a s223:InletConnectionPoint ;
    rdfs:label "water_inlet" ;
    s223:connectsThrough :chiller--cooling-coil-water_inlet ;
    s223:hasMedium s223:Fluid-Water ;
    s223:isConnectionPointOf :cooling-coil .

:oa-damper--supply-fan a s223:Duct ;
    rdfs:label "oa-damper--supply-fan" ;
    s223:connectsAt :oa-damper-out,
        :supply-fan-in ;
    s223:hasMedium s223:Fluid-Air .

:oa-damper-out a s223:OutletConnectionPoint ;
    rdfs:label "oa-damper-out" ;
    s223:connectsThrough :oa-damper--supply-fan ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :oa-damper .

:supply-fan--cooling-coil-air_inlet a s223:Duct ;
    rdfs:label "supply-fan--cooling-coil-air_inlet" ;
    s223:connectsAt :cooling-coil-air_inlet,
        :supply-fan-out ;
    s223:hasMedium s223:Fluid-Air .

:supply-fan-in a s223:InletConnectionPoint ;
    rdfs:label "supply-fan-in" ;
    s223:connectsThrough :oa-damper--supply-fan ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :supply-fan .

:supply-fan-out a s223:OutletConnectionPoint ;
    rdfs:label "supply-fan-out" ;
    s223:connectsThrough :supply-fan--cooling-coil-air_inlet ;
    s223:hasMedium s223:Fluid-Air ;
    s223:isConnectionPointOf :supply-fan .

:chiller a s223:Chiller ;
    rdfs:label "chiller" ;
    s223:hasConnectionPoint :chiller-in,
        :chiller-out .

:oa-damper a s223:Damper ;
    rdfs:label "oa-damper" ;
    s223:hasConnectionPoint :oa-damper-in,
        :oa-damper-out .

:supply-fan a s223:Fan ;
    rdfs:label "supply-fan" ;
    s223:hasConnectionPoint :supply-fan-in,
        :supply-fan-out .

:cooling-coil a hvac:AirWaterCoolingCoil ;
    rdfs:label "cooling-coil" ;
    s223:hasConnectionPoint :cooling-coil-air_inlet,
        :cooling-coil-air_outlet,
        :cooling-coil-water_inlet,
        :cooling-coil-water_outlet .

