    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:Landfill_outletPointShape .

<https://watermetadata.org/plumb/seawater-ro#LandfillShape/hasConnectionPoint/2> sh:maxCount 2 ;
    sh:minCount 2 ;
    sh:path s223:hasConnectionPoint .

ex:Landfill_inletPointShape sh:class s223:InletConnectionPoint ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#Landfill_inletPointShape/hasMedium/0>,
        <https://watermetadata.org/plumb/seawater-ro#Landfill_inletPointShape/label/1> .

<https://watermetadata.org/plumb/seawater-ro#Landfill_inletPointShape/hasMedium/0> sh:hasValue watr:Fluid-Sludge ;
