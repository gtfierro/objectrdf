@prefix codegen: <https://watermetadata.org/plumb/codegen#> .
@prefix ex: <https://watermetadata.org/plumb/seawater-ro#> .
@prefix kind: <http://qudt.org/vocab/quantitykind/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    owl:imports <https://watermetadata.org/ontology/watr> ;
    codegen:baseModule "plumb.watr" .

ex:AdvancedOxidationStageShape a sh:NodeShape ;
    sh:node ex:UVDesignShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#AdvancedOxidationStageShape/hasProcess/0> ;
    sh:targetClass ex:AdvancedOxidationStage .

ex:BackwashSeparatorShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/1>,
        <https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/2>,
        <https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/3>,
        <https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/4>,
        <https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasProcess/0> ;
    sh:targetClass ex:BackwashSeparator .

ex:BackwashStageShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#BackwashStageShape/hasProcess/0> ;
    sh:targetClass ex:BackwashStage .

ex:BoosterPumpShape a sh:NodeShape ;
    sh:node ex:PumpDesignShape ;
    sh:targetClass ex:BoosterPump .

ex:CartridgeFiltrationStageShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#CartridgeFiltrationStageShape/hasProcess/0> ;
    sh:targetClass ex:CartridgeFiltrationStage .

ex:ChlorinationStageShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#ChlorinationStageShape/hasProcess/0> ;
    sh:targetClass ex:ChlorinationStage .

ex:CoagulationStageShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#CoagulationStageShape/hasProcess/0> ;
    sh:targetClass ex:CoagulationStage .

ex:DosingStageShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#DosingStageShape/hasProcess/0> ;
    sh:targetClass ex:DosingStage .

ex:EnergyRecoveryExchangerShape a sh:NodeShape ;
    sh:node ex:PressureExchangerDesignShape ;
    sh:targetClass ex:EnergyRecoveryExchanger .

ex:FeedSplitterShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/1>,
        <https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/2>,
        <https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/3>,
        <https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/4>,
        <https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasMedium/0> ;
    sh:targetClass ex:FeedSplitter .

ex:HighPressurePumpShape a sh:NodeShape ;
    sh:node ex:HighPressurePumpDesignShape ;
    sh:targetClass ex:HighPressurePump .

ex:IntakePumpShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#IntakePumpShape/hasRole/0> ;
    sh:targetClass ex:IntakePump .

ex:LandfillShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#LandfillShape/hasConnectionPoint/0>,
        <https://watermetadata.org/plumb/seawater-ro#LandfillShape/hasConnectionPoint/1>,
        <https://watermetadata.org/plumb/seawater-ro#LandfillShape/hasConnectionPoint/2> ;
    sh:targetClass ex:Landfill .

ex:MediaFilterShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#MediaFilterShape/hasConnectionPoint/1>,
        <https://watermetadata.org/plumb/seawater-ro#MediaFilterShape/hasConnectionPoint/2>,
        <https://watermetadata.org/plumb/seawater-ro#MediaFilterShape/hasConnectionPoint/3>,
        <https://watermetadata.org/plumb/seawater-ro#MediaFilterShape/hasConnectionPoint/4>,
        <https://watermetadata.org/plumb/seawater-ro#MediaFilterShape/hasProcess/0> ;
    sh:targetClass ex:MediaFilter .

ex:MediaFiltrationStageShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#MediaFiltrationStageShape/hasProcess/0> ;
    sh:targetClass ex:MediaFiltrationStage .

ex:MixingStageShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#MixingStageShape/hasProcess/0> ;
    sh:targetClass ex:MixingStage .

ex:PermeateConnectionShape a sh:NodeShape ;
    sh:node ex:PermeateStateShape ;
    sh:targetClass ex:PermeateConnection .

ex:ROFeedMixerShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#ROFeedMixerShape/hasConnectionPoint/1>,
        <https://watermetadata.org/plumb/seawater-ro#ROFeedMixerShape/hasConnectionPoint/2>,
        <https://watermetadata.org/plumb/seawater-ro#ROFeedMixerShape/hasConnectionPoint/3>,
        <https://watermetadata.org/plumb/seawater-ro#ROFeedMixerShape/hasConnectionPoint/4>,
        <https://watermetadata.org/plumb/seawater-ro#ROFeedMixerShape/hasProcess/0> ;
    sh:targetClass ex:ROFeedMixer .

ex:ROStageShape a sh:NodeShape ;
    sh:node ex:MembraneDesignShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#ROStageShape/hasConnectionPoint/1>,
        <https://watermetadata.org/plumb/seawater-ro#ROStageShape/hasConnectionPoint/2>,
        <https://watermetadata.org/plumb/seawater-ro#ROStageShape/hasConnectionPoint/3>,
        <https://watermetadata.org/plumb/seawater-ro#ROStageShape/hasConnectionPoint/4>,
        <https://watermetadata.org/plumb/seawater-ro#ROStageShape/hasProcess/0> ;
    sh:targetClass ex:ROStage .

ex:SeawaterFeedShape a sh:NodeShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#SeawaterFeedShape/hasConnectionPoint/1>,
        <https://watermetadata.org/plumb/seawater-ro#SeawaterFeedShape/hasConnectionPoint/2>,
        <https://watermetadata.org/plumb/seawater-ro#SeawaterFeedShape/hasRole/0> ;
    sh:targetClass ex:SeawaterFeed .

ex:StorageTankShape a sh:NodeShape ;
    sh:node ex:ResidenceTimeDesignShape ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#StorageTankShape/hasRole/0> ;
    sh:targetClass ex:StorageTank .

ex:AdvancedOxidationStage a owl:Class ;
    rdfs:label "Advanced Oxidation Stage" ;
    rdfs:comment "Advanced Oxidation Stage configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:UVH2O2Reactor .

<https://watermetadata.org/plumb/seawater-ro#AdvancedOxidationStageShape/hasProcess/0> sh:hasValue watr:Process-AdvancedOxidation ;
    sh:path watr:hasProcess .

ex:BackwashSeparator a owl:Class ;
    rdfs:label "Backwash Separator" ;
    rdfs:comment "Backwash Separator configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:UnitProcess .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/1> sh:name "inlet" ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:BackwashSeparator_inletPointShape .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/2> sh:name "treated" ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:BackwashSeparator_treatedPointShape .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/3> sh:name "byproduct" ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:BackwashSeparator_byproductPointShape .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasConnectionPoint/4> sh:maxCount 3 ;
    sh:minCount 3 ;
    sh:path s223:hasConnectionPoint .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparatorShape/hasProcess/0> sh:hasValue watr:Process-Separation ;
    sh:path watr:hasProcess .

ex:BackwashSeparator_byproductPointShape sh:class s223:OutletConnectionPoint ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_byproductPointShape/hasMedium/0>,
        <https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_byproductPointShape/label/1> .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_byproductPointShape/hasMedium/0> sh:hasValue watr:Fluid-Sludge ;
    sh:path s223:hasMedium .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_byproductPointShape/label/1> sh:hasValue "byproduct" ;
    sh:path rdfs:label .

ex:BackwashSeparator_inletPointShape sh:class s223:InletConnectionPoint ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_inletPointShape/hasMedium/0>,
        <https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_inletPointShape/label/1> .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_inletPointShape/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:path s223:hasMedium .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_inletPointShape/label/1> sh:hasValue "inlet" ;
    sh:path rdfs:label .

ex:BackwashSeparator_treatedPointShape sh:class s223:OutletConnectionPoint ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_treatedPointShape/hasMedium/0>,
        <https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_treatedPointShape/label/1> .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_treatedPointShape/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:path s223:hasMedium .

<https://watermetadata.org/plumb/seawater-ro#BackwashSeparator_treatedPointShape/label/1> sh:hasValue "treated" ;
    sh:path rdfs:label .

ex:BackwashStage a owl:Class ;
    rdfs:label "Backwash Stage" ;
    rdfs:comment "Backwash Stage configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:UnitProcess .

<https://watermetadata.org/plumb/seawater-ro#BackwashStageShape/hasProcess/0> sh:hasValue watr:Process-Backwashing ;
    sh:path watr:hasProcess .

ex:BoosterPump a owl:Class ;
    rdfs:label "Booster Pump" ;
    rdfs:comment "Booster Pump configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:Pump .

ex:CartridgeFiltrationStage a owl:Class ;
    rdfs:label "Cartridge Filtration Stage" ;
    rdfs:comment "Cartridge Filtration Stage configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:CartridgeFiltrationUnit .

<https://watermetadata.org/plumb/seawater-ro#CartridgeFiltrationStageShape/hasProcess/0> sh:hasValue watr:Process-Filtration ;
    sh:path watr:hasProcess .

ex:ChlorinationStage a owl:Class ;
    rdfs:label "Chlorination Stage" ;
    rdfs:comment "Chlorination Stage configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:ChlorinationUnit .

<https://watermetadata.org/plumb/seawater-ro#ChlorinationStageShape/hasProcess/0> sh:hasValue watr:Process-Chlorination ;
    sh:path watr:hasProcess .

ex:CoagulationStage a owl:Class ;
    rdfs:label "Coagulation Stage" ;
    rdfs:comment "Coagulation Stage configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:CoagulationBasin .

<https://watermetadata.org/plumb/seawater-ro#CoagulationStageShape/hasProcess/0> sh:hasValue watr:Process-Coagulation ;
    sh:path watr:hasProcess .

ex:DosingStage a owl:Class ;
    rdfs:label "Dosing Stage" ;
    rdfs:comment "Dosing Stage configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:Reactor .

<https://watermetadata.org/plumb/seawater-ro#DosingStageShape/hasProcess/0> sh:hasValue watr:Process-Dosing ;
    sh:path watr:hasProcess .

ex:EnergyRecoveryExchanger a owl:Class ;
    rdfs:label "Energy Recovery Exchanger" ;
    rdfs:comment "Energy Recovery Exchanger configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:PressureExchanger .

ex:FeedSplitter a owl:Class ;
    rdfs:label "Feed Splitter" ;
    rdfs:comment "Feed Splitter configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf s223:Junction .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/1> sh:name "inlet" ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:FeedSplitter_inletPointShape .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/2> sh:name "pump" ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:FeedSplitter_pumpPointShape .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/3> sh:name "pressure_exchanger" ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:FeedSplitter_pressure_exchangerPointShape .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasConnectionPoint/4> sh:maxCount 3 ;
    sh:minCount 3 ;
    sh:path s223:hasConnectionPoint .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitterShape/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:path s223:hasMedium .

ex:FeedSplitter_inletPointShape sh:class s223:InletConnectionPoint ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#FeedSplitter_inletPointShape/hasMedium/0>,
        <https://watermetadata.org/plumb/seawater-ro#FeedSplitter_inletPointShape/label/1> .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitter_inletPointShape/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:path s223:hasMedium .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitter_inletPointShape/label/1> sh:hasValue "inlet" ;
    sh:path rdfs:label .

ex:FeedSplitter_pressure_exchangerPointShape sh:class s223:OutletConnectionPoint ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pressure_exchangerPointShape/hasMedium/0>,
        <https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pressure_exchangerPointShape/label/1> .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pressure_exchangerPointShape/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:path s223:hasMedium .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pressure_exchangerPointShape/label/1> sh:hasValue "pressure_exchanger" ;
    sh:path rdfs:label .

ex:FeedSplitter_pumpPointShape sh:class s223:OutletConnectionPoint ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pumpPointShape/hasMedium/0>,
        <https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pumpPointShape/label/1> .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pumpPointShape/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:path s223:hasMedium .

<https://watermetadata.org/plumb/seawater-ro#FeedSplitter_pumpPointShape/label/1> sh:hasValue "pump" ;
    sh:path rdfs:label .

ex:HighPressurePump a owl:Class ;
    rdfs:label "High Pressure Pump" ;
    rdfs:comment "High Pressure Pump configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:Pump .

ex:HighPressurePumpDesignShape a sh:NodeShape ;
    sh:description "HighPressurePumpDesign quantities with nominal aspects and shape-declared default units." ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesignShape/hasProperty/0>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesignShape/hasProperty/1> ;
    codegen:projection codegen:PropertySchema ;
    codegen:pythonName "HighPressurePumpDesign" .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesignShape/hasProperty/0> sh:description "Pump efficiency" ;
    sh:name "efficiency" ;
    sh:order 0 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:HighPressurePumpDesign_efficiencyShape ;
    codegen:localName "efficiency" .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesignShape/hasProperty/1> sh:description "Operating pressure" ;
    sh:name "operating_pressure" ;
    sh:order 1 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape ex:HighPressurePumpDesign_operating_pressureShape ;
    codegen:localName "operating-pressure" .

ex:HighPressurePumpDesign_efficiencyShape rdfs:label "Pump efficiency" ;
    sh:class s223:QuantifiableProperty ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasAspect/3>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasQuantityKind/1>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasUnit/2>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasValue/4>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/label/0> .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasAspect/3> sh:hasValue s223:Aspect-Nominal ;
    sh:path s223:hasAspect .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasQuantityKind/1> sh:hasValue kind:Efficiency ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:hasQuantityKind .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasUnit/2> sh:defaultValue unit:UNITLESS ;
    sh:in <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasUnit/2/allowedUnits> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:hasUnit .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasUnit/2/allowedUnits> rdf:first unit:UNITLESS ;
    rdf:rest () .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/hasValue/4> sh:datatype xsd:double ;
    sh:maxCount 1 ;
    sh:maxInclusive 1e+00 ;
    sh:minCount 1 ;
    sh:minInclusive 0e+00 ;
    sh:path s223:hasValue .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_efficiencyShape/label/0> sh:hasValue "Pump efficiency" ;
    sh:path rdfs:label .

ex:HighPressurePumpDesign_operating_pressureShape rdfs:label "Operating pressure" ;
    sh:class s223:QuantifiableProperty ;
    sh:property <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasAspect/3>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasQuantityKind/1>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasUnit/2>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasValue/4>,
        <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/label/0> .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasAspect/3> sh:hasValue s223:Aspect-Nominal ;
    sh:path s223:hasAspect .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasQuantityKind/1> sh:hasValue kind:Pressure ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:hasQuantityKind .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasUnit/2> sh:defaultValue unit:PA ;
    sh:in <https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasUnit/2/allowedUnits> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:hasUnit .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasUnit/2/allowedUnits> rdf:first unit:PA ;
    rdf:rest ( unit:KiloPA unit:BAR unit:PSI ) .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/hasValue/4> sh:datatype xsd:double ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0e+00 ;
    sh:path s223:hasValue .

<https://watermetadata.org/plumb/seawater-ro#HighPressurePumpDesign_operating_pressureShape/label/0> sh:hasValue "Operating pressure" ;
    sh:path rdfs:label .

ex:IntakePump a owl:Class ;
    rdfs:label "Intake Pump" ;
    rdfs:comment "Intake Pump configuration defined by the seawater RO shapes." ;
    rdfs:subClassOf watr:Pump .

<https://watermetadata.org/plumb/seawater-ro#IntakePumpShape/hasRole/0> sh:hasValue watr:Role-Feed ;
    sh:path s223:hasRole .

