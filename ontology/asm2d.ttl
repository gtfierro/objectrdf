@prefix asm2d: <https://w3id.org/objectrdf/asm2d#> .
@prefix codegen: <https://w3id.org/objectrdf/codegen#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qk: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

asm2d: a owl:Ontology ;
    rdfs:comment "ASM2d configurations and property groups for RDF-first model authoring." ;
    owl:imports <https://watermetadata.org/ontology/watr> ;
    codegen:baseModule "objectrdf.watr" .

asm2d:AerobicStageShape a sh:NodeShape ;
    sh:node asm2d:AerobicDesignShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#AerobicStageShape/ammonia-objective>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasConnectionPoint/5>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasConnectionPoint/6>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasConnectionPoint/7>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasProcess/0>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasProcess/1>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasRole/3>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasRole/4>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasTreatmentObjective/2> ;
    sh:targetClass asm2d:AerobicStage .

asm2d:AnaerobicStageShape a sh:NodeShape ;
    sh:node asm2d:ReactorDesignShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#AnaerobicStageShape/hasConnectionPoint/4>,
        <https://w3id.org/objectrdf/asm2d#AnaerobicStageShape/hasConnectionPoint/5>,
        <https://w3id.org/objectrdf/asm2d#AnaerobicStageShape/hasConnectionPoint/6>,
        <https://w3id.org/objectrdf/asm2d#AnaerobicStageShape/hasProcess/0>,
        <https://w3id.org/objectrdf/asm2d#AnaerobicStageShape/hasRole/2>,
        <https://w3id.org/objectrdf/asm2d#AnaerobicStageShape/hasRole/3>,
        <https://w3id.org/objectrdf/asm2d#AnaerobicStageShape/hasTreatmentObjective/1> ;
    sh:targetClass asm2d:AnaerobicStage .

asm2d:AnoxicStageShape a sh:NodeShape ;
    sh:node asm2d:ReactorDesignShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#AnoxicStageShape/hasConnectionPoint/4>,
        <https://w3id.org/objectrdf/asm2d#AnoxicStageShape/hasConnectionPoint/5>,
        <https://w3id.org/objectrdf/asm2d#AnoxicStageShape/hasConnectionPoint/6>,
        <https://w3id.org/objectrdf/asm2d#AnoxicStageShape/hasProcess/0>,
        <https://w3id.org/objectrdf/asm2d#AnoxicStageShape/hasRole/2>,
        <https://w3id.org/objectrdf/asm2d#AnoxicStageShape/hasRole/3>,
        <https://w3id.org/objectrdf/asm2d#AnoxicStageShape/hasTreatmentObjective/1> ;
    sh:targetClass asm2d:AnoxicStage .

asm2d:InfluentMixerShape a sh:NodeShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#InfluentMixerShape/hasConnectionPoint/1>,
        <https://w3id.org/objectrdf/asm2d#InfluentMixerShape/hasConnectionPoint/2>,
        <https://w3id.org/objectrdf/asm2d#InfluentMixerShape/hasConnectionPoint/3>,
        <https://w3id.org/objectrdf/asm2d#InfluentMixerShape/hasConnectionPoint/4>,
        <https://w3id.org/objectrdf/asm2d#InfluentMixerShape/hasProcess/0> ;
    sh:targetClass asm2d:InfluentMixer .

asm2d:InternalRecycleSplitterShape a sh:NodeShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#InternalRecycleSplitterShape/hasConnectionPoint/1>,
        <https://w3id.org/objectrdf/asm2d#InternalRecycleSplitterShape/hasConnectionPoint/2>,
        <https://w3id.org/objectrdf/asm2d#InternalRecycleSplitterShape/hasConnectionPoint/3>,
        <https://w3id.org/objectrdf/asm2d#InternalRecycleSplitterShape/hasConnectionPoint/4>,
        <https://w3id.org/objectrdf/asm2d#InternalRecycleSplitterShape/hasMedium/0> ;
    sh:targetClass asm2d:InternalRecycleSplitter .

asm2d:RecycleMixerShape a sh:NodeShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#RecycleMixerShape/hasConnectionPoint/1>,
        <https://w3id.org/objectrdf/asm2d#RecycleMixerShape/hasConnectionPoint/2>,
        <https://w3id.org/objectrdf/asm2d#RecycleMixerShape/hasConnectionPoint/3>,
        <https://w3id.org/objectrdf/asm2d#RecycleMixerShape/hasConnectionPoint/4>,
        <https://w3id.org/objectrdf/asm2d#RecycleMixerShape/hasProcess/0> ;
    sh:targetClass asm2d:RecycleMixer .

asm2d:RecyclePumpShape a sh:NodeShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#RecyclePumpShape/hasConnectionPoint/0>,
        <https://w3id.org/objectrdf/asm2d#RecyclePumpShape/hasConnectionPoint/1>,
        <https://w3id.org/objectrdf/asm2d#RecyclePumpShape/hasConnectionPoint/2> ;
    sh:targetClass asm2d:RecyclePump .

asm2d:SecondaryClarifierShape a sh:NodeShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#SecondaryClarifierShape/hasConnectionPoint/3>,
        <https://w3id.org/objectrdf/asm2d#SecondaryClarifierShape/hasConnectionPoint/4>,
        <https://w3id.org/objectrdf/asm2d#SecondaryClarifierShape/hasConnectionPoint/5>,
        <https://w3id.org/objectrdf/asm2d#SecondaryClarifierShape/hasConnectionPoint/6>,
        <https://w3id.org/objectrdf/asm2d#SecondaryClarifierShape/hasProcess/0>,
        <https://w3id.org/objectrdf/asm2d#SecondaryClarifierShape/hasRole/2>,
        <https://w3id.org/objectrdf/asm2d#SecondaryClarifierShape/hasTreatmentObjective/1> ;
    sh:targetClass asm2d:SecondaryClarifier .

asm2d:SludgeSplitterShape a sh:NodeShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#SludgeSplitterShape/hasConnectionPoint/1>,
        <https://w3id.org/objectrdf/asm2d#SludgeSplitterShape/hasConnectionPoint/2>,
        <https://w3id.org/objectrdf/asm2d#SludgeSplitterShape/hasConnectionPoint/3>,
        <https://w3id.org/objectrdf/asm2d#SludgeSplitterShape/hasConnectionPoint/4>,
        <https://w3id.org/objectrdf/asm2d#SludgeSplitterShape/hasMedium/0> ;
    sh:targetClass asm2d:SludgeSplitter .

asm2d:SplitFractionShape a sh:NodeShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#SplitFractionShape/hasSplitBasis/0> ;
    sh:targetClass asm2d:SplitFraction .

asm2d:ASM2dStateShape a sh:NodeShape ;
    sh:description "Nominal influent conditions: flow in m³/day, temperature in K, pressure in Pa, component pools in g/m³, and alkalinity in mol/m³. Component pools retain their defined COD, nitrogen, phosphorus, or solids basis." ;
    sh:property <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/0>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/1>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/10>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/11>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/12>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/13>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/14>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/15>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/16>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/17>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/18>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/19>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/2>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/20>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/21>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/3>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/4>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/5>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/6>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/7>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/8>,
        <https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/9> ;
    codegen:projection codegen:PropertySchema ;
    codegen:pythonName "ASM2dState" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/0> sh:description "Flow rate" ;
    sh:name "flow_rate" ;
    sh:order 0 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:FlowRateShape .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/1> sh:description "Temperature" ;
    sh:name "temperature" ;
    sh:order 1 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:TemperatureShape .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/10> sh:description "Dissolved nitrogen" ;
    sh:name "dissolved_nitrogen" ;
    sh:order 10 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:DissolvedNitrogenShape ;
    codegen:localName "s_n2-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/11> sh:description "Inert particulate organics" ;
    sh:name "inert_particulate_organics" ;
    sh:order 11 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:InertParticulateOrganicsShape ;
    codegen:localName "x_i-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/12> sh:description "Slowly biodegradable substrate" ;
    sh:name "slowly_biodegradable_substrate" ;
    sh:order 12 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:SlowlyBiodegradableSubstrateShape ;
    codegen:localName "x_s-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/13> sh:description "Heterotrophic biomass" ;
    sh:name "heterotrophic_biomass" ;
    sh:order 13 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:HeterotrophicBiomassShape ;
    codegen:localName "x_h-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/14> sh:description "Phosphate accumulating biomass" ;
    sh:name "phosphate_accumulating_biomass" ;
    sh:order 14 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:PhosphateAccumulatingBiomassShape ;
    codegen:localName "x_pao-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/15> sh:description "Stored polyphosphate" ;
    sh:name "stored_polyphosphate" ;
    sh:order 15 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:StoredPolyphosphateShape ;
    codegen:localName "x_pp-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/16> sh:description "Stored pha" ;
    sh:name "stored_pha" ;
    sh:order 16 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:StoredPhaShape ;
    codegen:localName "x_pha-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/17> sh:description "Autotrophic biomass" ;
    sh:name "autotrophic_biomass" ;
    sh:order 17 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:AutotrophicBiomassShape ;
    codegen:localName "x_aut-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/18> sh:description "Metal hydroxides" ;
    sh:name "metal_hydroxides" ;
    sh:order 18 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:MetalHydroxidesShape ;
    codegen:localName "x_meoh-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/19> sh:description "Metal phosphates" ;
    sh:name "metal_phosphates" ;
    sh:order 19 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:MetalPhosphatesShape ;
    codegen:localName "x_mep-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/2> sh:description "Pressure" ;
    sh:name "pressure" ;
    sh:order 2 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:PressureShape .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/20> sh:description "Total suspended solids" ;
    sh:name "total_suspended_solids" ;
    sh:order 20 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:TotalSuspendedSolidsShape ;
    codegen:localName "x_tss-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/21> sh:description "Alkalinity" ;
    sh:name "alkalinity" ;
    sh:order 21 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:AlkalinityShape ;
    codegen:localName "s_alk-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/3> sh:description "Dissolved oxygen" ;
    sh:name "dissolved_oxygen" ;
    sh:order 3 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:DissolvedOxygenShape ;
    codegen:localName "s_o2-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/4> sh:description "Fermentable substrate" ;
    sh:name "fermentable_substrate" ;
    sh:order 4 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:FermentableSubstrateShape ;
    codegen:localName "s_f-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/5> sh:description "Fermentation products" ;
    sh:name "fermentation_products" ;
    sh:order 5 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:FermentationProductsShape ;
    codegen:localName "s_a-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/6> sh:description "Ammonia ammonium nitrogen" ;
    sh:name "ammonia_ammonium_nitrogen" ;
    sh:order 6 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:AmmoniaAmmoniumNitrogenShape ;
    codegen:localName "s_nh4-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/7> sh:description "Nitrate nitrite nitrogen" ;
    sh:name "nitrate_nitrite_nitrogen" ;
    sh:order 7 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:NitrateNitriteNitrogenShape ;
    codegen:localName "s_no3-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/8> sh:description "Soluble inorganic phosphorus" ;
    sh:name "soluble_inorganic_phosphorus" ;
    sh:order 8 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:SolubleInorganicPhosphorusShape ;
    codegen:localName "s_po4-concentration" .

<https://w3id.org/objectrdf/asm2d#ASM2dStateShape/hasProperty/9> sh:description "Inert soluble organics" ;
    sh:name "inert_soluble_organics" ;
    sh:order 9 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:InertSolubleOrganicsShape ;
    codegen:localName "s_i-concentration" .

asm2d:AerobicDesignShape a sh:NodeShape ;
    sh:description "Aerobic basin volume in m³ (default 1333) and oxygen transfer coefficient KLa in h⁻¹." ;
    sh:property <https://w3id.org/objectrdf/asm2d#AerobicDesignShape/hasProperty/0>,
        <https://w3id.org/objectrdf/asm2d#AerobicDesignShape/hasProperty/1> ;
    codegen:projection codegen:PropertySchema ;
    codegen:pythonName "AerobicDesign" .

<https://w3id.org/objectrdf/asm2d#AerobicDesignShape/hasProperty/0> sh:description "Volume" ;
    sh:name "volume" ;
    sh:order 0 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:AerobicVolumeShape .

<https://w3id.org/objectrdf/asm2d#AerobicDesignShape/hasProperty/1> sh:description "Oxygen transfer coefficient" ;
    sh:name "oxygen_transfer_coefficient" ;
    sh:order 1 ;
    sh:path s223:hasProperty ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape asm2d:OxygenTransferCoefficientShape .

asm2d:AerobicStage a owl:Class ;
    rdfs:label "AerobicStage" ;
    rdfs:subClassOf watr:AerationBasin .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/ammonia-objective> sh:hasValue watr:TreatmentObjective-AmmoniaControl ;
    sh:path watr:hasTreatmentObjective .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasConnectionPoint/5> sh:maxCount 2 ;
    sh:minCount 2 ;
    sh:path s223:hasConnectionPoint .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasConnectionPoint/6> sh:name "inlet" ;
    sh:order 0 ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape <https://w3id.org/objectrdf/asm2d#AerobicStageShape/inlet> .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasConnectionPoint/7> sh:name "outlet" ;
    sh:order 1 ;
    sh:path s223:hasConnectionPoint ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape <https://w3id.org/objectrdf/asm2d#AerobicStageShape/outlet> .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasProcess/0> sh:hasValue watr:Process-Nitrification ;
    sh:path watr:hasProcess .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasProcess/1> sh:hasValue watr:Process-Aeration ;
    sh:path watr:hasProcess .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasRole/3> sh:hasValue watr:Role-Aerobic ;
    sh:path s223:hasRole .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasRole/4> sh:hasValue watr:Role-Secondary ;
    sh:path s223:hasRole .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/hasTreatmentObjective/2> sh:hasValue watr:TreatmentObjective-NitrogenRemoval ;
    sh:path watr:hasTreatmentObjective .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/inlet> a sh:NodeShape ;
    sh:class s223:InletConnectionPoint ;
    sh:property <https://w3id.org/objectrdf/asm2d#AerobicStageShape/inlet/hasMedium/0>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/inlet/label/1> .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/inlet/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:maxCount 1 ;
    sh:path s223:hasMedium .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/inlet/label/1> sh:hasValue "inlet" ;
    sh:maxCount 1 ;
    sh:path rdfs:label .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/outlet> a sh:NodeShape ;
    sh:class s223:OutletConnectionPoint ;
    sh:node asm2d:OxygenOutletStateShape ;
    sh:property <https://w3id.org/objectrdf/asm2d#AerobicStageShape/outlet/hasMedium/0>,
        <https://w3id.org/objectrdf/asm2d#AerobicStageShape/outlet/label/1> .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/outlet/hasMedium/0> sh:hasValue s223:Fluid-Water ;
    sh:maxCount 1 ;
    sh:path s223:hasMedium .

<https://w3id.org/objectrdf/asm2d#AerobicStageShape/outlet/label/1> sh:hasValue "outlet" ;
    sh:maxCount 1 ;
    sh:path rdfs:label .

asm2d:AerobicVolumeShape a sh:NodeShape ;
    rdfs:label "AerobicVolume" ;
    sh:class s223:QuantifiableProperty ;
    sh:property <https://w3id.org/objectrdf/asm2d#AerobicVolumeShape/hasAspect/3>,
        <https://w3id.org/objectrdf/asm2d#AerobicVolumeShape/hasValue/2>,
        <https://w3id.org/objectrdf/asm2d#AerobicVolumeShape/http://qudt.org/schema/qudt/hasQuantityKind/0>,
        <https://w3id.org/objectrdf/asm2d#AerobicVolumeShape/http://qudt.org/schema/qudt/hasUnit/1> .

<https://w3id.org/objectrdf/asm2d#AerobicVolumeShape/hasAspect/3> sh:hasValue s223:Aspect-Nominal ;
    sh:path s223:hasAspect .

<https://w3id.org/objectrdf/asm2d#AerobicVolumeShape/hasValue/2> sh:datatype xsd:double ;
    sh:defaultValue 1333 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path s223:hasValue .

<https://w3id.org/objectrdf/asm2d#AerobicVolumeShape/http://qudt.org/schema/qudt/hasQuantityKind/0> sh:hasValue qk:Volume ;
    sh:maxCount 1 ;
