brickshape:VirtualMeterRule a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Only meters can have the isVirtualMeter property be true" ;
            sh:prefixes ns4:Brick ;
            sh:select """
