        bricktag:Overload,
        bricktag:Point .

brick:Overridden_Off_Status a owl:Class,
        sh:NodeShape ;
    rdfs:label "Overridden Off Status"@en ;
    rdfs:subClassOf brick:Off_Status,
        brick:Overridden_Status ;
