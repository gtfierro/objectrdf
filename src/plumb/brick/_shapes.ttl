        "kilogram na metr krychlový"@cs,
        "Kilogramm je Kubikmeter"@de,
        "χιλιόγραμμο ανά κυβικό μέτρο"@el,
        "kilogram per cubic metre"@en,
        "kilogram per cubic meter"@en-us,
        "kilogramo por metro cúbico"@es,
        "کیلوگرم بر متر مکعب"@fa,
