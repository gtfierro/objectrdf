        unit:KiloM-PER-HR,
        unit:KiloM-PER-SEC,
        unit:M-PER-HR,
        unit:M-PER-SEC,
        unit:MI-PER-HR,
        unit:MI-PER-SEC ;
    qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T-1D0 ;
    rdfs:isDefinedBy schema6:Brick ;
    skos:broader quantitykind:Speed,
        brick:Speed ;
