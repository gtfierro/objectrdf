            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Pressure ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Differential,
        bricktag:Filter,
        bricktag:Point,
        bricktag:Pressure,
        bricktag:Sensor ;
    brick:hasQuantity brick:Differential_Pressure .

brick:Flow_Setpoint a owl:Class,
        sh:NodeShape ;
