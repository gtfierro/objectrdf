        unit:J-PER-SEC,
        unit:KiloBTU_IT-PER-HR,
        unit:KiloCAL-PER-MIN,
        unit:KiloCAL-PER-SEC,
        unit:KiloGM_F-M-PER-SEC,
        unit:KiloJ-PER-DAY,
        unit:KiloJ-PER-HR,
        unit:KiloJ-PER-MIN,
        unit:KiloJ-PER-SEC,
        unit:KiloW,
