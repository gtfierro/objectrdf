brick:Current_Imbalance a brick:Quantity ;
    rdfs:label "CurrentImbalance"@en ;
    qudt:applicableUnit unit:PERCENT ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1 ;
    rdfs:isDefinedBy schema6:Brick ;
    skos:broader quantitykind:Dimensionless ;
    skos:definition "The percent deviation from average current",
        "The percent deviation from average current"@en ;
    skos:related brick:Electric_Current .

brick:Current_Output_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Current Output Sensor"@en ;
    rdfs:subClassOf brick:Current_Sensor ;
    skos:definition "Senses the amperes of electrical current produced as output by a device"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Current ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Output ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Current,
        bricktag:Output,
        bricktag:Point,
        bricktag:Sensor ;
    brick:hasQuantity quantitykind:ElectricCurrent .

brick:DDAHU a owl:Class,
        sh:NodeShape ;
    rdfs:label "DDAHU"@en ;
    rdfs:subClassOf brick:Air_Handling_Unit ;
    owl:equivalentClass brick:Dual_Duct_Air_Handling_Unit ;
    skos:definition "See Dual_Duct_Air_Handling_Unit"@en ;
    brick:aliasOf brick:Dual_Duct_Air_Handling_Unit .

brick:Dedicated_Outdoor_Air_System_Unit a owl:Class,
        sh:NodeShape ;
    rdfs:label "Dedicated Outdoor Air System Unit"@en ;
    rdfs:subClassOf brick:Air_Handling_Unit ;
    owl:equivalentClass brick:DOAS ;
    skos:definition "A device that conditions and delivers 100% outdoor air to its assigned spaces. It decouples air-conditioning of the outdoor air, usually used to provide minimum outdoor air ventilation, from conditioning of the internal loads."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Outdoor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Dedicated ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:DOAS ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:System ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Air,
        bricktag:DOAS,
        bricktag:Dedicated,
        bricktag:Equipment,
        bricktag:Outdoor,
        bricktag:System .

brick:Differential_CO2_Concentration a brick:Quantity ;
