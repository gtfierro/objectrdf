        qudt:Unit ;
    rdfs:label "Oct"@en ;
    dcterms:description "An octave is a doubling or halving of a frequency.  One oct is the logarithmic frequency interval between $f1$ and $f2$ when $f2/f1 = 2$."^^qudt:LatexString ;
    qudt:applicableSystem sou:ASU,
        sou:CGS,
        sou:CGS-EMU,
        sou:CGS-ESU,
        sou:CGS-GAUSS,
