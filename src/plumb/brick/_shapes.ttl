            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Color,
        bricktag:Command,
        bricktag:Correlated,
        bricktag:Lighting,
        bricktag:Point,
        bricktag:Temperature .

