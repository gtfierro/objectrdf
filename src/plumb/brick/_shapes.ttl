brick:Air_Handling_Unit a owl:Class,
        sh:NodeShape ;
    rdfs:label "Air Handling Unit"@en ;
    rdfs:subClassOf brick:HVAC_Equipment ;
    owl:equivalentClass brick:AHU,
        brick:Air_Handler_Unit ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Handling ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Handler ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Unit ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:AHU ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:AHU,
        bricktag:Air,
        bricktag:Equipment,
        bricktag:Handler,
        bricktag:Handling,
        bricktag:Unit .

brick:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    sh:property brickshape:hasLocationShape,
        brickshape:hasdeprecationShape,
        brickshape:isReplacedByShape,
        brickshape:latitudeShape,
        brickshape:longitudeShape,
        brickshape:timestampShape .

brick:Space a owl:Class,
        sh:NodeShape ;
    rdfs:label "Space"@en ;
    rdfs:subClassOf brick:Location ;
    owl:deprecated true ;
    skos:definition "A part of the physical world or a virtual world whose 3D spatial extent is bounded actually or theoretically, and provides for certain functions within the zone it is contained in."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Space ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Location ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:deprecatedInVersion "1.4.0" ;
    brick:deprecationMitigationMessage "Brick location classes are being phased out in favor of RealEstateCore classes. For a replacement, consider rec:Space" ;
    brick:hasAssociatedTag bricktag:Location,
        bricktag:Space ;
    brick:isReplacedBy rec:Space .

brick:Water_Temperature_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Water Temperature Sensor"@en ;
    rdfs:subClassOf brick:Temperature_Sensor ;
    skos:definition "Measures the temperature of water"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Point,
        bricktag:Sensor,
        bricktag:Temperature,
        bricktag:Water ;
    brick:hasQuantity brick:Temperature ;
    brick:hasSubstance brick:Water .

