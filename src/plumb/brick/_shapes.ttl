            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Condenser,
        bricktag:Condensing,
        bricktag:Cooling,
        bricktag:Equipment,
        bricktag:Heating,
        bricktag:Recovery,
        bricktag:Unit .

