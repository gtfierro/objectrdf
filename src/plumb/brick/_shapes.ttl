    rdfs:domain qudt:Unit ;
    rdfs:isDefinedBy schema2:qudt,
        shacl:qudt ;
    rdfs:range qudt:SystemOfUnits .

qudt:permissibleMaths a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "permissible maths" ;
    rdfs:isDefinedBy schema2:qudt,
        shacl:qudt .

