            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Pressure ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Point,
        bricktag:Pressure,
        bricktag:Sensor,
        bricktag:Water ;
    brick:hasQuantity brick:Pressure .

brick:Water_Temperature_Alarm a owl:Class,
        sh:NodeShape ;
    rdfs:label "Water Temperature Alarm"@en ;
    rdfs:subClassOf brick:Temperature_Alarm,
        brick:Water_Alarm ;
