    rdfs:subClassOf brick:Status ;
    skos:definition "Indicates if a control loop, relay or equipment is on"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Status ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:On ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:On,
        bricktag:Point,
        bricktag:Status .

brick:On_Timer_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "On Timer Sensor"@en ;
    rdfs:subClassOf brick:Duration_Sensor ;
    owl:equivalentClass brick:Run_Time_Sensor ;
    skos:definition "Measures the duration for which a device was in an active or \"on\" state"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Time ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Run ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Timer ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:On ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:On,
        bricktag:Point,
        bricktag:Run,
        bricktag:Sensor,
        bricktag:Time,
        bricktag:Timer ;
    brick:hasQuantity quantitykind:Time .

brick:Outside_Air_Lockout_Temperature_Differential_Parameter a owl:Class,
