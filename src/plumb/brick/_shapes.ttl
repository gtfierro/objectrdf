    rdfs:label "byte rate" ;
    qudt:applicableUnit unit:BYTE-PER-SEC,
        unit:GigaBYTE-PER-SEC,
        unit:MegaBYTE-PER-SEC ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0 ;
    qudt:iec61360Code "0112/2///62720#UAD020" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD020"^^xsd:anyURI ;
    rdfs:comment "Applicable units are those of quantitykind:ByteRate" ;
    rdfs:isDefinedBy vocab:quantitykind .

