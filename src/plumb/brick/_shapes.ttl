    rdfs:label "big point" ;
    dcterms:description "unit for the type size correspondening to: 1 bp = 1/72 in" ;
    qudt:conversionMultiplier 0.0003527778 ;
    qudt:conversionMultiplierSN 3.527778e-04 ;
    qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T0D0 ;
    qudt:hasQuantityKind quantitykind:Distance ;
