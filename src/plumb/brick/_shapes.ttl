        unit:J-PER-CentiM2-DAY,
        unit:KiloCAL-PER-CentiM2-MIN,
        unit:KiloCAL-PER-CentiM2-SEC,
        unit:KiloW-PER-M2,
        unit:M-PA-PER-SEC,
        unit:MicroW-PER-M2,
        unit:MilliW-PER-M2,
        unit:NanoW-PER-M2,
        unit:PicoW-PER-M2,
        unit:W-PER-CentiM2,
        unit:W-PER-FT2,
        unit:W-PER-IN2,
        unit:W-PER-M2 ;
    qudt:deprecated true ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T-3D0 ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Heat_flux"^^xsd:anyURI ;
    qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI ;
    rdfs:comment "Applicable units are those of quantitykind:PowerPerArea" ;
    rdfs:isDefinedBy vocab:quantitykind ;
    skos:broader quantitykind:PowerPerArea .

