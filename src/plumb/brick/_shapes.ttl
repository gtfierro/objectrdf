    qudt:informativeReference "http://en.wikipedia.org/wiki/Exa-?oldid=494400216"^^xsd:anyURI ;
    qudt:prefixMultiplier 1e+18 ;
    qudt:siExactMatch prefixes:exa ;
    qudt:symbol "E" ;
    qudt:ucumCode "E" ;
    rdfs:isDefinedBy vocab:prefix .

