            sh:nodeKind sh:IRI ;
            sh:path rec:locatedIn ],
        [ a sh:PropertyShape ;
            sh:class rec:BuildingElement ;
            sh:maxCount 1 ;
            sh:name "is part of" ;
            sh:nodeKind sh:IRI ;
            sh:path rec:isPartOf ],
        [ a sh:PropertyShape ;
            sh:class rec:BuildingElement ;
            sh:name "has part" ;
            sh:nodeKind sh:IRI ;
            sh:path rec:hasPart ],
        [ a sh:PropertyShape ;
