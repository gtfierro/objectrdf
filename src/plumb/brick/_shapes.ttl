    qudt:latexSymbol "$J/(kg \\cdot K)$"^^qudt:LatexString ;
    qudt:symbol "J/(kg·K)" ;
    qudt:ucumCode "J.kg-1.K-1"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "B11" ;
    rdfs:isDefinedBy vocab:unit .

