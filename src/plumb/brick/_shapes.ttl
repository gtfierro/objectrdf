        "eficiência"@pt,
        "коэффициент полезного действия"@ru,
        "效率"@zh ;
    dcterms:description "Efficiency is the ratio of output power to input power."^^qudt:LatexString ;
    qudt:applicableUnit unit:FRACTION,
        unit:GR,
