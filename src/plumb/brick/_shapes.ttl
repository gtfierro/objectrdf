brick:Contact_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Contact Sensor"@en ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Senses or detects contact, such as for determining if a door is closed."@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class rec:BooleanValueObservation ;
            sh:maxCount 1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Contact ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Contact,
        bricktag:Point,
        bricktag:Sensor ;
    brick:hasQuantity quantitykind:Dimensionless .

