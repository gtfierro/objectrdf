quantitykind:Entropy a qudt:QuantityKind ;
    rdfs:label "إنتروبيا"@ar,
        "entropie"@cs,
        "Entropie"@de,
        "entropy"@en,
        "entropía"@es,
        "آنتروپی"@fa,
        "entropie"@fr,
        "एन्ट्रॉपी"@hi,
        "entropia"@it,
        "エントロピー"@ja,
