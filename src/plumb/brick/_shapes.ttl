    rdfs:label "Linear Electric Current"@en ;
    dcterms:description "\"Linear Electric Linear Current\" is the electric current per unit line."^^qudt:LatexString ;
    qudt:applicableUnit unit:A-PER-CentiM,
        unit:A-PER-M,
        unit:A-PER-MilliM,
        unit:KiloA-PER-M,
