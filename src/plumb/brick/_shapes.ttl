            sh:path brick:hasQuantity ],
        [ a sh:PropertyShape ;
            sh:class brick:Substance ;
            sh:name "has substance" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:hasSubstance ],
        [ sh:maxCount 0 ;
            sh:message "Points cannot have locations; use 'isPointOf' instead" ;
            sh:path brick:hasLocation ],
        [ a sh:PropertyShape ;
            sh:name "is point of" ;
            sh:nodeKind sh:IRI ;
