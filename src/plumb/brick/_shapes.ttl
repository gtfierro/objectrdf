quantitykind:RestMass a qudt:QuantityKind ;
    rdfs:label "كتلة ساكنة"@ar,
        "Klidová hmotnost"@cs,
        "Ruhemasse"@de,
        "rest mass"@en,
        "masa invariante"@es,
        "جرم سکون"@fa,
