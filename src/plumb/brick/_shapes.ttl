        unit:KiloCAL-PER-MOL,
        unit:KiloJ-PER-MOL ;
    qudt:expression "$j-mol^{-1}$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimensionvector:A-1E0L2I0M1H0T-2D0 ;
