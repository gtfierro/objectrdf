        bricktag:RVAV,
        bricktag:Reheat,
        bricktag:Variable,
        bricktag:Volume .

brick:Voltage_Imbalance a brick:Quantity ;
    rdfs:label "VoltageImbalance"@en ;
    qudt:applicableUnit unit:PERCENT ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1 ;
    rdfs:isDefinedBy schema6:Brick ;
