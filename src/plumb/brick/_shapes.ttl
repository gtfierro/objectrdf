    qudt:guidance "<p>See NIST section <a href=\"http://physics.nist.gov/Pubs/SP811/sec07.html#7.10\">SP811 section7.10</a></p>"^^rdf:HTML ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1 ;
