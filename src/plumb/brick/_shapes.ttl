        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "Adult Education" "Ambulatory Surgical Center" "Aquarium" "Automobile Dealership" "Bank Branch" "Bar/Nightclub" "Barracks" "Bowling Alley" "Casino" "College/University" "Convenience Store with Gas Station" "Convenience Store without Gas Station" "Convention Center" "Courthouse" "Data Center" "Distribution Center" "Drinking Water Treatment & Distribution" "Enclosed Mall" "Energy/Power Station" "Fast Food Restaurant" "Financial Office" "Fire Station" "Fitness Center/Health Club/Gym" "Food Sales" "Food Service" "Hospital (General Medical & Surgical)" "Hotel" "Ice/Curling Rink" "Indoor Arena" "K-12 School" "Laboratory" "Library" "Lifestyle Center" "Mailing Center/Post Office" "Manufacturing/Industrial Plant" "Medical Office" "Mixed Use Property" "Movie Theater" "Multifamily Housing" "Museum" "Non-Refrigerated Warehouse" "Office" "Other - Education" "Other - Entertainment/Public Assembly" "Other - Lodging/Residential" "Other - Mall" "Other - Public Services" "Other - Recreation" "Other - Restaurant/Bar" "Other - Services" "Other - Stadium" "Other - Technology/Science" "Other - Utility" "Other" "Other/Specialty Hospital" "Outpatient Rehabilitation/Physical Therapy" "Parking" "Performing Arts" "Personal Services (Health/Beauty, Dry Cleaning, etc)" "Police Station" "Pre-school/Daycare" "Prison/Incarceration" "Race Track" "Refrigerated Warehouse" "Repair Services (Vehicle, Shoe, Locksmith, etc)" "Residence Hall/Dormitory" "Restaurant" "Retail Store" "Roller Rink" "Self-Storage Facility" "Senior Care Community" "Single Family Home" "Social/Meeting Hall" "Stadium (Closed)" "Stadium (Open)" "Strip Mall" "Supermarket/Grocery Store" "Swimming Pool" "Transportation Terminal/Station" "Urgent Care/Clinic/Other Outpatient" "Veterinary Office" "Vocational School" "Wastewater Treatment Plant" "Wholesale Club/Supercenter" "Worship Facility" "Zoo" "Adult Education" "Ambulatory Surgical Center" "Aquarium" "Automobile Dealership" "Bank Branch" "Bar/Nightclub" "Barracks" "Bowling Alley" "Casino" "College/University" "Convenience Store with Gas Station" "Convenience Store without Gas Station" "Convention Center" "Courthouse" "Data Center" "Distribution Center" "Drinking Water Treatment & Distribution" "Enclosed Mall" "Energy/Power Station" "Fast Food Restaurant" "Financial Office" "Fire Station" "Fitness Center/Health Club/Gym" "Food Sales" "Food Service" "Hospital (General Medical & Surgical)" "Hotel" "Ice/Curling Rink" "Indoor Arena" "K-12 School" "Laboratory" "Library" "Lifestyle Center" "Mailing Center/Post Office" "Manufacturing/Industrial Plant" "Medical Office" "Mixed Use Property" "Movie Theater" "Multifamily Housing" "Museum" "Non-Refrigerated Warehouse" "Office" "Other - Education" "Other - Entertainment/Public Assembly" "Other - Lodging/Residential" "Other - Mall" "Other - Public Services" "Other - Recreation" "Other - Restaurant/Bar" "Other - Services" "Other - Stadium" "Other - Technology/Science" "Other - Utility" "Other" "Other/Specialty Hospital" "Outpatient Rehabilitation/Physical Therapy" "Parking" "Performing Arts" "Personal Services (Health/Beauty, Dry Cleaning, etc)" "Police Station" "Pre-school/Daycare" "Prison/Incarceration" "Race Track" "Refrigerated Warehouse" "Repair Services (Vehicle, Shoe, Locksmith, etc)" "Residence Hall/Dormitory" "Restaurant" "Retail Store" "Roller Rink" "Self-Storage Facility" "Senior Care Community" "Single Family Home" "Social/Meeting Hall" "Stadium (Closed)" "Stadium (Open)" "Strip Mall" "Supermarket/Grocery Store" "Swimming Pool" "Transportation Terminal/Station" "Urgent Care/Clinic/Other Outpatient" "Veterinary Office" "Vocational School" "Wastewater Treatment Plant" "Wholesale Club/Supercenter" "Worship Facility" "Zoo" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:CoolingCapacityShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( unit:TON_FG unit:BTU_IT-PER-HR unit:BTU_TH-PER-HR unit:W ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or brickshape:NumericValue ;
            sh:path brick:value ] .

brickshape:CoordinateShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:or brickshape:NumericValue ;
            sh:path brick:latitude ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:or brickshape:NumericValue ;
            sh:path brick:longitude ] .

brickshape:CurrentFlowTypeShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "AC" "DC" "AC" "DC" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:ElectricalComplexPowerShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "real" "reactive" "apparent" "real" "reactive" "apparent" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:ElectricalFlowShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "import" "export" "net" "absolute" "import" "export" "net" "absolute" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:PhaseCountShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( 1 2 3 "Total" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:PhasesShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( "A" "B" "C" "AB" "BC" "AC" "ABC" "A" "B" "C" "AB" "BC" "AC" "ABC" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:TemperatureCoefficientPerDegreeCelsiusShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( unit:PERCENT ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or brickshape:NumericValue ;
            sh:path brick:value ] .

brickshape:TiltShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or brickshape:NumericValue ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:in ( unit:MicroRAD unit:RAD unit:GON unit:REV unit:MilliARCSEC unit:MilliRAD unit:MIN_Angle unit:ARCMIN unit:ARCSEC unit:DEG unit:GRAD unit:MIL ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ] .

brickshape:VirtualMeterShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:VolumeShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:in ( unit:FT3 unit:M3 ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or brickshape:NumericValue ;
            sh:path brick:value ] .

brickshape:YearBuiltShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf brickshape:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

brickshape:hasAddressShape a sh:PropertyShape ;
    sh:class ns2:Address ;
    sh:path brick:hasAddress .

brickshape:hasAssociatedTagShape a sh:PropertyShape ;
    sh:class brick:Tag ;
    sh:path brick:hasAssociatedTag .

brickshape:hasInputSubstanceShape a sh:PropertyShape ;
    sh:class brick:Substance ;
    sh:path brick:hasInputSubstance .

brickshape:hasLocationShape a sh:PropertyShape ;
    sh:class brick:Location ;
    sh:path brick:hasLocation .

brickshape:hasOutputSubstanceShape a sh:PropertyShape ;
    sh:class brick:Substance ;
    sh:path brick:hasOutputSubstance .

brickshape:hasQUDTReferenceShape a sh:PropertyShape ;
    sh:class qudt:QuantityKind ;
    sh:path brick:hasQUDTReference .

brickshape:hasQuantityShape a sh:PropertyShape ;
    sh:or ( [ sh:class brick:Quantity ] [ sh:class qudt:QuantityKind ] ) ;
    sh:path brick:hasQuantity .

brickshape:hasSubMeterShape a sh:PropertyShape ;
    sh:class brick:Meter ;
    sh:path brick:hasSubMeter .

brickshape:hasTagShape a sh:PropertyShape ;
    sh:class brick:Tag ;
    sh:path brick:hasTag .

brickshape:hasUnitShape a sh:PropertyShape ;
    sh:class qudt:Unit ;
    sh:path brick:hasUnit .

brickshape:hasaggregateShape a sh:PropertyShape ;
    rdfs:label "has Aggregate property"@en ;
    sh:node brickshape:AggregationShape ;
    sh:path brick:aggregate .

brickshape:hasareaShape a sh:PropertyShape ;
    rdfs:label "has Area property"@en ;
    sh:node brickshape:AreaShape ;
    sh:path brick:area .

brickshape:hasazimuthShape a sh:PropertyShape ;
    rdfs:label "has Azimuth property"@en ;
    sh:node brickshape:AzimuthShape ;
    sh:path brick:azimuth .

brickshape:hasbuildingPrimaryFunctionShape a sh:PropertyShape ;
    rdfs:label "has Building primary function property"@en ;
    sh:node brickshape:BuildingPrimaryFunctionShape ;
    sh:path brick:buildingPrimaryFunction .

brickshape:hasbuildingThermalTransmittanceShape a sh:PropertyShape ;
    rdfs:label "has Building thermal transmittance property"@en ;
