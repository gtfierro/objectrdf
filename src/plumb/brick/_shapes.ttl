        bricktag:Delay,
        bricktag:Parameter,
        bricktag:Point .

brick:Ammonia_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Ammonia Sensor"@en ;
    rdfs:subClassOf brick:Air_Quality_Sensor ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Ammonia ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
