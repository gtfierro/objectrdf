        brickshape:haselectricalFlowShape,
        brickshape:haslastKnownValueShape,
        brickshape:isPointOfShape ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
