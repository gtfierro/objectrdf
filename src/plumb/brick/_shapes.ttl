brick:Leaving_Hot_Water_Temperature_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Leaving Hot Water Temperature Sensor"@en ;
    rdfs:subClassOf brick:Water_Temperature_Sensor ;
