    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Direction ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Direction,
        bricktag:Point,
        bricktag:Sensor ;
    brick:hasQuantity brick:Direction .

brick:Direction_Status a owl:Class,
