    rdfs:subClassOf brick:Cooling_Zone_Air_Temperature_Setpoint,
        brick:Unoccupied_Air_Temperature_Setpoint ;
    skos:definition "Sets temperature of air when unoccupied for cooling within a specific zone"@en ;
