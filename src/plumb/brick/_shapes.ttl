        unit:MilliM-PER-SEC,
        unit:MilliM-PER-YR,
        unit:YD-PER-HR,
        unit:YD-PER-MIN,
        unit:YD-PER-SEC ;
    qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T-1D0 ;
