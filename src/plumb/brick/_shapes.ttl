        sh:NodeShape ;
    rdfs:label "Condenser Heat Exchanger"@en ;
    rdfs:subClassOf brick:Heat_Exchanger ;
    skos:definition "A heat exchanger in which the primary heat transfer vapor changes its state to a liquid phase."@en ;
