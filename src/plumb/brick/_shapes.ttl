        bricktag:Outside,
        bricktag:Point,
        bricktag:Setpoint,
        bricktag:Temperature ;
    brick:hasQuantity brick:Temperature ;
    brick:hasSubstance brick:Outside_Air .

brick:Switchgear a owl:Class,
        sh:NodeShape ;
    rdfs:label "Switchgear"@en ;
    rdfs:subClassOf brick:Electrical_Equipment ;
    skos:definition "A main disconnect or service disconnect feeds power to a switchgear, which then distributes power to the rest of the building through smaller amperage-rated disconnects."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Switchgear ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Equipment,
        bricktag:Switchgear .

brick:Target_Zone_Air_Temperature_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Target Zone Air Temperature Setpoint"@en ;
    rdfs:subClassOf brick:Air_Temperature_Setpoint ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Target ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Zone ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Air,
        bricktag:Point,
        bricktag:Setpoint,
        bricktag:Target,
        bricktag:Temperature,
        bricktag:Zone ;
    brick:hasQuantity brick:Temperature ;
    brick:hasSubstance brick:Zone_Air .

