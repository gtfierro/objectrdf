    qudt:symbol "kg/s" ;
    qudt:ucumCode "kg.s-1"^^qudt:UCUMcs,
        "kg/s"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "KGS" ;
    rdfs:isDefinedBy vocab:unit .

