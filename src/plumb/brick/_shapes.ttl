            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Command,
        bricktag:Maintenance,
        bricktag:Mode,
        bricktag:Point .

brick:Maintenance_Required_Alarm a owl:Class,
        sh:NodeShape ;
    rdfs:label "Maintenance Required Alarm"@en ;
