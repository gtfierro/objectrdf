    qudt:hasQuantityKind quantitykind:ThrustToMassRatio ;
    qudt:symbol "N/kg" ;
    qudt:ucumCode "N.kg-1"^^qudt:UCUMcs,
        "N/kg"^^qudt:UCUMcs ;
