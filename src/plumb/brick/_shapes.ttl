    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Supply ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Heat ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Flow ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Discharge ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Air,
        bricktag:Discharge,
        bricktag:Flow,
        bricktag:Heat,
        bricktag:Point,
        bricktag:Setpoint,
        bricktag:Supply ;
    brick:hasQuantity quantitykind:VolumeFlowRate .

brick:Integral_Time_Parameter a owl:Class,
        sh:NodeShape ;
    rdfs:label "Integral Time Parameter"@en ;
    rdfs:subClassOf brick:Time_Parameter ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
