brick:Frost a brick:Substance ;
    skos:broader brick:Solid ;
    skos:definition "frost formed on the cold surface (tubes, plates) of a cooling coil."@en .

brick:Gauge_Pressure_Sensor a owl:Class,
        sh:NodeShape ;
