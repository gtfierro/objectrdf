quantitykind:AngularVelocity a qudt:QuantityKind ;
    rdfs:label "سرعة زاوية"@ar,
        "Úhlová rychlost"@cs,
        "Winkelgeschwindigkeit"@de,
        "angular velocity"@en,
        "velocidad angular"@es,
