brick:Enthalpy_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Enthalpy Sensor"@en ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Measures the total heat content of some substance"@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class rec:DoubleValueObservation ;
            sh:maxCount 1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Enthalpy ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Enthalpy,
        bricktag:Point,
        bricktag:Sensor ;
    brick:hasQuantity quantitykind:Enthalpy .

