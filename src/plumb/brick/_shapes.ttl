            sh:object bricktag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Target ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Occupied ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Air,
        bricktag:Occupied,
        bricktag:Point,
        bricktag:Setpoint,
        bricktag:Target,
        bricktag:Temperature,
        bricktag:Zone ;
    brick:hasQuantity brick:Temperature .

