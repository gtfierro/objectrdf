qudt:fieldCode a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "field code" ;
    qudt:plainTextDescription """
  A field code is a generic property for representing unique codes that make up other identifers. 
  For example each QuantityKind class caries a domain code as its field code.
  """,
        "A field code is a generic property for representing unique codes that make up other identifers. For example each QuantityKind class caries a domain code as its field code." ;
    rdfs:isDefinedBy schema2:qudt,
        shacl:qudt ;
