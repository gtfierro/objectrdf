    qudt:prefix prefix:Milli ;
    qudt:symbol "mrad" ;
    qudt:ucumCode "mrad"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "C25" ;
    rdfs:isDefinedBy vocab:unit .

