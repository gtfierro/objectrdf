    qudt:plainTextDescription "A non-SI-conforming unit of pressure, that corresponds with the static pressure generated by a mercury column with the height of 1 centimetre" ;
    qudt:symbol "cmHg" ;
    qudt:ucumCode "cm[Hg]"^^qudt:UCUMcs ;
    qudt:udunitsCode "cmHg",
        "cm_Hg" ;
    qudt:uneceCommonCode "J89" ;
    rdfs:isDefinedBy vocab:unit .

