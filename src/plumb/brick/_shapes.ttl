    rdfs:subClassOf brick:Supply_Air_Temperature_Sensor ;
    owl:equivalentClass brick:Preheat_Discharge_Air_Temperature_Sensor ;
    skos:definition "Measures the temperature of supply air before it is heated"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Discharge ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Preheat ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Supply ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Air,
        bricktag:Discharge,
        bricktag:Point,
        bricktag:Preheat,
        bricktag:Sensor,
        bricktag:Supply,
        bricktag:Temperature ;
    brick:hasQuantity brick:Temperature .

brick:Pressure_Alarm a owl:Class,
        sh:NodeShape ;
