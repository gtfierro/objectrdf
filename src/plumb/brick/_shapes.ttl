        unit:KiloV-A-HR,
        unit:KiloV-A_Reactive-HR,
        unit:KiloW-HR,
        unit:MegaEV,
        unit:MegaJ,
        unit:MegaTOE,
        unit:MegaV-A-HR,
        unit:MegaV-A_Reactive-HR,
        unit:MegaW-HR,
        unit:MicroJ,
        unit:MilliJ,
        unit:NanoJ,
        unit:PetaJ,
        unit:PicoJ,
        unit:PlanckEnergy,
        unit:QUAD,
        unit:THERM_EC,
