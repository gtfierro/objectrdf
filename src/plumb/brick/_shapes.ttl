    rdfs:label "US Survey Foot"@en ;
    dcterms:description "<p>The U.S. Survey Foot was officially deprecated on December 31, 2022. For more information see <a href=\"https://www.govinfo.gov/content/pkg/FR-2020-10-05/pdf/2020-21902.pdf\">Federal Register (October 5, 2020, 85 FR 62698, p. 62698)</a></p>"^^rdf:HTML ;
