            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Pump ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
