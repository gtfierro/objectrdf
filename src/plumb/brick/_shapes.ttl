skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:isDefinedBy skos2:core ;
    skos:definition "An idea or notion; a unit of thought."@en .

brick:Air_Flow_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Air Flow Sensor"@en ;
    rdfs:subClassOf brick:Flow_Sensor ;
    skos:definition "Measures the rate of flow of air"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Air ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Flow ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Air,
        bricktag:Flow,
        bricktag:Point,
        bricktag:Sensor ;
    brick:hasQuantity quantitykind:VolumeFlowRate ;
    brick:hasSubstance brick:Air .

brick:Cooling_Temperature_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Cooling Temperature Setpoint"@en ;
    rdfs:subClassOf brick:Temperature_Setpoint ;
    skos:definition "Sets temperature for cooling"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Cool ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Cool,
        bricktag:Point,
        bricktag:Setpoint,
        bricktag:Temperature ;
    brick:hasQuantity brick:Temperature .

brick:ICT_Equipment a owl:Class,
        sh:NodeShape ;
    rdfs:label "ICT Equipment"@en ;
    rdfs:subClassOf brick:Equipment ;
    skos:definition "Information and Communications Technology (ICT) equipment operates with a processor to process data or logic and create digital signals."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:ICT ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Equipment,
        bricktag:ICT .

brick:Leaving_Hot_Water a brick:Substance ;
    skos:broader brick:Hot_Water,
        brick:Leaving_Water .

brick:Temperature_Deadband_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Temperature Deadband Setpoint"@en ;
    rdfs:subClassOf brick:Deadband_Setpoint,
        brick:Temperature_Setpoint ;
    skos:definition "Sets the size of a deadband of temperature"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Deadband ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Deadband,
        bricktag:Point,
        bricktag:Setpoint,
        bricktag:Temperature ;
    brick:hasQuantity brick:Temperature .

brick:Water_Flow_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Water Flow Setpoint"@en ;
    rdfs:subClassOf brick:Flow_Setpoint ;
    skos:definition "Sets the target flow rate of water"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Flow ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Flow,
        bricktag:Point,
        bricktag:Setpoint,
        bricktag:Water ;
    brick:hasQuantity quantitykind:VolumeFlowRate ;
    brick:hasSubstance brick:Water .

brick:Water_Temperature_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Water Temperature Setpoint"@en ;
    rdfs:subClassOf brick:Temperature_Setpoint ;
    skos:definition "Sets temperature of water"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Point,
        bricktag:Setpoint,
        bricktag:Temperature,
        bricktag:Water ;
    brick:hasQuantity brick:Temperature ;
    brick:hasSubstance brick:Water .

brick:Zone_Air a brick:Substance ;
    skos:broader brick:Air ;
    skos:definition "air inside a defined zone (e.g., corridors)."@en .

