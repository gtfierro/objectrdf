        unit:K-PER-K,
        unit:MilliK-PER-K ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1 ;
    qudt:qkdvDenominator dimensionvector:A0E0L0I0M0H1T0D0 ;
    qudt:qkdvNumerator dimensionvector:A0E0L0I0M0H1T0D0 ;
    rdfs:comment "Applicable units are those of quantitykind:TemperatureRatio" ;
    rdfs:isDefinedBy vocab:quantitykind ;
