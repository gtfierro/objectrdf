brick:Hot_Water_Differential_Pressure_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Hot Water Differential Pressure Sensor"@en ;
    rdfs:subClassOf brick:Water_Differential_Pressure_Sensor ;
    skos:definition "Measures the difference in water pressure on either side of a hot water valve"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Differential ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Hot ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Pressure ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Differential,
        bricktag:Hot,
        bricktag:Point,
        bricktag:Pressure,
        bricktag:Sensor,
        bricktag:Water ;
    brick:hasQuantity brick:Differential_Pressure ;
    brick:hasSubstance brick:Hot_Water .

