    brick:aliasOf brick:Unoccupied_Supply_Air_Flow_Setpoint .

brick:Unoccupied_Discharge_Air_Temperature_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Unoccupied Discharge Air Temperature Setpoint"@en ;
