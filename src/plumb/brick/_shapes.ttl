unit:HZ-PER-K a qudt:Unit ;
    rdfs:label "هرتز لكل كلفن"@ar,
        "hertz na kelvin"@cs,
        "Hertz je Kelvin"@de,
        "hertz per kelvin"@en,
        "hercio por kelvin"@es,
        "هرتز بر کلوین"@fa,
        "hertz par kelvin"@fr,
        "हर्ट्ज प्रति कैल्विन"@hi,
        "hertz al kelvin"@it,
        "ヘルツ毎立方メートル"@ja,
        "hertz per kelvin"@ms,
        "herc na kelwin"@pl,
