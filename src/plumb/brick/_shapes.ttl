brick:Frequency_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Frequency Sensor"@en ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Measures the frequency of a phenomenon or aspect of a phenomenon, e.g. the frequency of a fan turning"@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class rec:FrequencyObservation ;
            sh:maxCount 1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object bricktag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Frequency ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object bricktag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag bricktag:Frequency,
        bricktag:Point,
        bricktag:Sensor ;
    brick:hasQuantity brick:Frequency .

