            sh:in ( unit:MicroRAD unit:RAD unit:ARCSEC unit:GON unit:MilliARCSEC unit:REV unit:MilliRAD unit:ARCMIN unit:DEG unit:GRAD unit:MIL ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or brickshape:NumericValue ;
            sh:path brick:value ] .

